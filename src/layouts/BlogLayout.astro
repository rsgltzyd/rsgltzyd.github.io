---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title: string;
  description: string;
  lang?: string;
  current?: 'home' | 'game' | 'about';
  /** Play pages fill the viewport and skip the masthead, footer, and shell padding. */
  bare?: boolean;
}

const { title, description, lang = 'zh-CN', current, bare = false } = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme="dark" data-theme-mode="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#202120" />
    <title>{title}</title>
    <!--
      Blocking tokens so the first paint uses --paper/--ink before global.css.
      These two pairs must match :root[data-theme] in global.css and THEME_COLOR
      in ThemeController.ts.
    -->
    <style is:inline>
      html, body {
        min-height: 100%;
        min-height: 100dvh;
        margin: 0;
        padding: 0;
        background-color: var(--paper);
      }
      html {
        --paper: #202120;
        --ink: #eeece5;
        background-color: var(--paper);
        color: var(--ink);
        color-scheme: dark;
      }
      html[data-theme="light"] {
        --paper: #ffffff;
        --ink: #1c1c1b;
        background-color: var(--paper);
        color: var(--ink);
        color-scheme: light;
      }
      html[data-theme="dark"] {
        --paper: #202120;
        --ink: #eeece5;
        background-color: var(--paper);
        color: var(--ink);
        color-scheme: dark;
      }
    </style>
    <script is:inline>
      (function () {
        var key = 'yl-theme-mode-v1';
        var mode = 'dark';
        try {
          var stored = window.localStorage.getItem(key);
          if (stored === 'light' || stored === 'dark' || stored === 'auto') mode = stored;
        } catch (error) {
          mode = 'dark';
        }
        var resolved = mode;
        if (mode === 'auto') {
          var now = new Date();
          var mins = now.getHours() * 60 + now.getMinutes();
          resolved = mins >= 6 * 60 && mins < 18 * 60 ? 'light' : 'dark';
        }
        var root = document.documentElement;
        root.setAttribute('data-theme', resolved);
        root.setAttribute('data-theme-mode', mode);
        root.style.colorScheme = resolved;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', resolved === 'light' ? '#ffffff' : '#202120');
      })();
    </script>
    <ClientRouter />
  </head>
  <body class:list={['journal-paper', bare && 'game-play-body']}>
    {bare ? (
      <slot />
    ) : (
      <div class="site-shell journal-paper">
        <Masthead current={current} />
        <main id="main">
          <slot />
        </main>
        <Footer />
      </div>
    )}
    {!bare && <BackToTop />}
    <script>
      const themeAttrs = ['data-theme', 'data-theme-mode'] as const;

      function modeLabel(mode: string) {
        if (mode === 'light') return '浅色';
        if (mode === 'auto') return '自动';
        return '深色';
      }

      function paintThemeControls(root: ParentNode, mode: string) {
        const label = modeLabel(mode);
        root.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach((button) => {
          button.setAttribute('aria-pressed', button.getAttribute('data-theme-choice') === mode ? 'true' : 'false');
        });
        root.querySelectorAll<HTMLElement>('[data-theme-menu-label]').forEach((node) => {
          node.textContent = `${label} ▾`;
        });
        root.querySelectorAll<HTMLElement>('[data-theme-menu-trigger]').forEach((trigger) => {
          trigger.setAttribute('aria-label', `切换主题，当前${label}`);
        });
      }

      function syncMastheadNav() {
        const path = location.pathname.replace(/\/index\.html$/, '').replace(/\/$/, '') || '/';
        const hash = location.hash.toLowerCase();
        const view = path === '/games' || path.startsWith('/games/') ? 'game' : path === '/' && hash === '#about' ? 'about' : 'home';
        document.querySelectorAll<HTMLAnchorElement>('[data-nav-view]').forEach((link) => {
          const on = link.getAttribute('data-nav-view') === view && view !== 'home';
          link.classList.toggle('active', on);
          if (on) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });
      }

      /* The router replaces <html> attributes from the next document, whose
         markup always says dark. Copy the live theme across first, and paint
         the incoming header controls so they do not flash the default. */
      document.addEventListener('astro:before-swap', (event) => {
        const nextDoc = (event as Event & { newDocument?: Document }).newDocument;
        if (!nextDoc) return;
        const root = document.documentElement;
        const nextRoot = nextDoc.documentElement;
        for (const name of themeAttrs) {
          const value = root.getAttribute(name);
          if (value) nextRoot.setAttribute(name, value);
        }
        if (root.style.colorScheme) nextRoot.style.colorScheme = root.style.colorScheme;
        const content = document.querySelector('meta[name="theme-color"]')?.getAttribute('content');
        const nextMeta = nextDoc.querySelector('meta[name="theme-color"]');
        if (content && nextMeta) nextMeta.setAttribute('content', content);
        paintThemeControls(nextDoc, root.getAttribute('data-theme-mode') || 'dark');
      });

      document.addEventListener('astro:after-swap', () => {
        paintThemeControls(document, document.documentElement.getAttribute('data-theme-mode') || 'dark');
        syncMastheadNav();
      });
    </script>
  </body>
</html>
