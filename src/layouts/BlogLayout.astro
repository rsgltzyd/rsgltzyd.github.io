---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import WeatherBackdrop from '../components/WeatherBackdrop.astro';

interface Props {
  title: string;
  description: string;
  lang?: string;
}

const { title, description, lang = 'zh-CN' } = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme="dark" data-edition="night" data-weather="clear">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#d3dce6" />
    <title>{title}</title>
    <!--
      Blocking tokens so the first paint uses --paper/--ink before global.css.
      These edition tokens must match global.css and EDITION_PAPER in ThemeController.ts.
    -->
    <style is:inline>
      html, body {
        min-height: 100%;
        min-height: 100dvh;
        margin: 0;
        padding: 0;
        background-color: var(--paper);
      }
      html {
        --paper: #d3dce6;
        --ink: #1d2733;
        background-color: var(--paper);
        color: var(--ink);
        color-scheme: light;
      }
      html[data-theme="light"],
      html[data-edition="day"] {
        --paper: #f6f2e9;
        --ink: #1a1917;
        background-color: var(--paper);
        color: var(--ink);
        color-scheme: light;
      }
      html[data-edition="morning"] {
        --paper: #f7f0e4;
        --ink: #1e1a16;
        background-color: var(--paper);
        color: var(--ink);
        color-scheme: light;
      }
      html[data-edition="evening"] {
        --paper: #efe4d2;
        --ink: #241c15;
        background-color: var(--paper);
        color: var(--ink);
        color-scheme: light;
      }
      html[data-theme="dark"],
      html[data-edition="night"] {
        --paper: #d3dce6;
        --ink: #1d2733;
        background-color: var(--paper);
        color: var(--ink);
        color-scheme: light;
      }
    </style>
    <script is:inline>
      (function () {
        const now = new Date();
        const mins = now.getHours() * 60 + now.getMinutes();
        let edition = 'night';
        if (mins >= 5 * 60 + 30 && mins < 8 * 60 + 30) edition = 'morning';
        else if (mins >= 8 * 60 + 30 && mins < 16 * 60 + 30) edition = 'day';
        else if (mins >= 16 * 60 + 30 && mins < 19 * 60) edition = 'evening';
        const resolved = edition === 'night' ? 'dark' : 'light';

        let weather = 'clear';
        try {
          const raw = window.localStorage.getItem('yl-weather-cache-v1');
          if (raw) {
            const parsed = JSON.parse(raw);
            const age = Date.now() - Number(parsed && parsed.ts);
            const kind = parsed && parsed.weather;
            if (
              (kind === 'clear' || kind === 'cloudy' || kind === 'rain' || kind === 'snow') &&
              Number.isFinite(age) &&
              age >= 0 &&
              age < 30 * 60 * 1000
            ) {
              weather = kind;
            }
          }
        } catch {
          weather = 'clear';
        }

        const paperByEdition = {
          morning: '#f7f0e4',
          day: '#f6f2e9',
          evening: '#efe4d2',
          night: '#d3dce6',
        };
        const root = document.documentElement;
        root.setAttribute('data-theme', resolved);
        root.setAttribute('data-edition', edition);
        root.setAttribute('data-weather', weather);
        root.style.colorScheme = 'light';
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', paperByEdition[edition]);
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="journal-paper">
    <WeatherBackdrop />
    <div class="site-shell journal-paper">
      <Masthead />
      <main id="main" transition:name="page-stage">
        <slot />
      </main>
      <Footer />
    </div>
    <BackToTop />
    <script>
      const themeAttrs = ['data-theme', 'data-edition', 'data-weather'] as const;
      let cleanupTimer: number | null = null;

      function normalizePath(path: string): string {
        return path.replace(/\/+$/, '') || '/';
      }

      function isSubpage(path: string): boolean {
        return path === '/globe' || path === '/gallery';
      }

      document.addEventListener('astro:before-preparation', (event) => {
        if (cleanupTimer !== null) {
          window.clearTimeout(cleanupTimer);
          cleanupTimer = null;
        }
        const navEvent = event as Event & { from?: URL; to?: URL };
        const fromPath = normalizePath(navEvent.from?.pathname ?? window.location.pathname);
        const toPath = normalizePath(navEvent.to?.pathname ?? '');

        if (isSubpage(toPath) && !isSubpage(fromPath)) {
          document.documentElement.dataset.routeTransition = 'enter-globe';
        } else if (isSubpage(fromPath) && toPath === '/') {
          document.documentElement.dataset.routeTransition = 'leave-globe';
        } else {
          delete document.documentElement.dataset.routeTransition;
        }
      });

      /* The router replaces <html> attributes from the next document, whose
         markup defaults to dark/night/clear. Copy the live edition and weather across. */
      document.addEventListener('astro:before-swap', (event) => {
        const nextDoc = (event as Event & { newDocument?: Document }).newDocument;
        if (!nextDoc) return;
        const root = document.documentElement;
        const nextRoot = nextDoc.documentElement;
        for (const name of themeAttrs) {
          const value = root.getAttribute(name);
          if (value) nextRoot.setAttribute(name, value);
        }
        const routeTransition = root.getAttribute('data-route-transition');
        if (routeTransition) nextRoot.setAttribute('data-route-transition', routeTransition);
        else nextRoot.removeAttribute('data-route-transition');

        if (root.style.colorScheme) nextRoot.style.colorScheme = root.style.colorScheme;
        const content = document.querySelector('meta[name="theme-color"]')?.getAttribute('content');
        const nextMeta = nextDoc.querySelector('meta[name="theme-color"]');
        if (content && nextMeta) nextMeta.setAttribute('content', content);
      });

      document.addEventListener('astro:page-load', () => {
        if (cleanupTimer !== null) {
          window.clearTimeout(cleanupTimer);
        }
        cleanupTimer = window.setTimeout(() => {
          delete document.documentElement.dataset.routeTransition;
          cleanupTimer = null;
        }, 450);
      });
    </script>
  </body>
</html>
