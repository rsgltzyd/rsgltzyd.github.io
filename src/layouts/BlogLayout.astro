---
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  lang?: string;
}

const { title, description, lang = 'zh-CN' } = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme="dark" data-theme-mode="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#202120" />
    <title>{title}</title>
    <!--
      Blocking tokens so the first paint uses --paper/--ink before global.css.
      These two pairs must match :root[data-theme] in global.css and THEME_COLOR
      in ThemeController.ts. theme-color cannot read a CSS variable.
    -->
    <style is:inline>
      html {
        --paper: #202120;
        --ink: #eeece5;
        background: var(--paper);
        color: var(--ink);
        color-scheme: dark;
      }
      html[data-theme="light"] {
        --paper: #ffffff;
        --ink: #1c1c1b;
        background: var(--paper);
        color: var(--ink);
        color-scheme: light;
      }
      html[data-theme="dark"] {
        --paper: #202120;
        --ink: #eeece5;
        background: var(--paper);
        color: var(--ink);
        color-scheme: dark;
      }
    </style>
    <script is:inline>
      (function () {
        var key = 'yl-theme-mode-v1';
        var mode = 'dark';
        try {
          var stored = window.localStorage.getItem(key);
          if (stored === 'light' || stored === 'dark' || stored === 'auto') mode = stored;
        } catch (error) {
          mode = 'dark';
        }
        var resolved = mode;
        if (mode === 'auto') {
          var prefersDark = true;
          try {
            prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches === true;
          } catch (error) {
            prefersDark = true;
          }
          resolved = prefersDark ? 'dark' : 'light';
        }
        var root = document.documentElement;
        root.setAttribute('data-theme', resolved);
        root.setAttribute('data-theme-mode', mode);
        root.style.colorScheme = resolved;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', resolved === 'light' ? '#ffffff' : '#202120');
      })();
    </script>
  </head>
  <body>
    <Masthead />
    <main id="main">
      <div class="site-shell">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
