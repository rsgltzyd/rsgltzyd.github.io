---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f5f0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Fieldnotes home">fieldnotes<span>.</span></a>
        <nav aria-label="Main navigation">
          <a href="/">Writing</a>
          <a href="mailto:2712495353@qq.com">Say hello <span aria-hidden="true">↗</span></a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>Made slowly, with care.</span>
        <span>© {new Date().getFullYear()} Fieldnotes</span>
      </footer>
    </div>
  </body>
</html>