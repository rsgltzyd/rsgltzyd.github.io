---

<div class="weather-backdrop" transition:persist="weather-backdrop" aria-hidden="true">
  <div class="wb-layer wb-clear">
    <div class="wb-sunlight"></div>
    <div class="wb-moonlight"></div>
    <div class="wb-stars">
      {BACKDROP_STARS.map((s) => (
        <span
          class:list={['wb-star', s.wide && 'wb-wide']}
          style={`left: ${s.left}; top: ${s.top}; --wb-twinkle-dur: ${s.dur}; --wb-twinkle-delay: ${s.delay};`}
        >
          <svg viewBox="0 0 12 12" width={s.size} height={s.size}>
            {s.kind === 'cross' ? (
              <path
                d="M6 1.5 L6 10.5 M1.5 6 L10.5 6"
                fill="none"
                stroke-width="1.05"
                stroke-linecap="round"
                vector-effect="non-scaling-stroke"
              ></path>
            ) : (
              <circle cx="6" cy="6" r="1.4" class="wb-star-dot"></circle>
            )}
          </svg>
        </span>
      ))}
    </div>
  </div>

  <div class="wb-layer wb-cloudy">
    <div class="wb-overcast"></div>
    <div class="wb-haze wb-haze-a"></div>
    <div class="wb-haze wb-haze-b"></div>
    {BACKDROP_CLOUDS.map((c) => (
      <svg
        class:list={['wb-cloud', c.wide && 'wb-wide']}
        viewBox="0 0 128 70"
        style={`left: ${c.left}; top: ${c.top}; width: ${c.w}px; --wb-cloud-alpha: ${c.alpha}; --wb-cloud-dur: ${c.dur}; --wb-cloud-delay: ${c.delay};`}
      >
        <path
          d={c.d}
          stroke-width="1.25"
          stroke-linecap="round"
          stroke-linejoin="round"
          vector-effect="non-scaling-stroke"
        ></path>
      </svg>
    ))}
    {BACKDROP_CLOUD_STREAKS.map((s) => (
      <svg
        class:list={['wb-cloud-streak', s.wide && 'wb-wide']}
        viewBox="0 0 212 22"
        style={`left: ${s.left}; top: ${s.top}; width: ${s.w}px; --wb-cloud-alpha: ${s.alpha}; --wb-cloud-dur: ${s.dur}; --wb-cloud-delay: ${s.delay};`}
      >
        <path
          d={s.d}
          fill="none"
          stroke-width="1"
          stroke-linecap="round"
          vector-effect="non-scaling-stroke"
        ></path>
      </svg>
    ))}
  </div>

  <div class="wb-layer wb-rain">
    <div class="wb-rain-mist"></div>
  </div>

  <div class="wb-layer wb-snow">
    <div class="wb-snow-mist"></div>
  </div>

  <canvas class="wb-canvas" data-weather-canvas aria-hidden="true"></canvas>
</div>

<style>
  .weather-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    transition: opacity 320ms ease, visibility 0s linear 0s;
  }

  .wb-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .wb-layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 480ms ease, visibility 0s linear 480ms;
  }

  .wb-layer * {
    animation-play-state: paused !important;
  }

  :global(html[data-weather="clear"]) .wb-clear,
  :global(html[data-weather="cloudy"]) .wb-cloudy,
  :global(html[data-weather="rain"]) .wb-rain,
  :global(html[data-weather="snow"]) .wb-snow {
    opacity: 1;
    visibility: visible;
    transition: opacity 480ms ease, visibility 0s linear 0s;
  }

  :global(html[data-weather="clear"]) .wb-clear *,
  :global(html[data-weather="cloudy"]) .wb-cloudy *,
  :global(html[data-weather="rain"]) .wb-rain *,
  :global(html[data-weather="snow"]) .wb-snow * {
    animation-play-state: running !important;
  }

  /* Clear: daylight corner glow */
  .wb-sunlight {
    display: none;
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 58% 48% at 88% 4%,
      color-mix(in srgb, #f6cf8a 18%, transparent),
      transparent 72%
    );
  }

  :global(html[data-theme="light"]) .wb-sunlight {
    display: block;
  }

  :global(html[data-edition="morning"]) .wb-sunlight {
    background: radial-gradient(
      ellipse 60% 50% at 86% 6%,
      color-mix(in srgb, #f4be82 22%, transparent),
      transparent 72%
    );
  }

  :global(html[data-edition="evening"]) .wb-sunlight {
    background: radial-gradient(
      ellipse 64% 52% at 84% 8%,
      color-mix(in srgb, #e5a358 26%, transparent),
      transparent 74%
    );
  }

  /* Clear: night moonlight wash + stars */
  .wb-moonlight {
    display: none;
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 56% 46% at 86% 6%,
      color-mix(in srgb, #ffffff 42%, transparent),
      transparent 72%
    );
  }

  :global(html[data-theme="dark"]) .wb-moonlight {
    display: block;
  }

  .wb-stars {
    display: none;
    position: absolute;
    inset: 0;
  }

  :global(html[data-theme="dark"]) .wb-stars {
    display: block;
  }

  .wb-star {
    position: absolute;
    transform: translate(-50%, -50%);
    opacity: 0.36;
    line-height: 0;
  }

  .wb-star path {
    stroke: var(--ink);
  }

  .wb-star-dot {
    fill: var(--ink);
  }

  /* Cloudy */
  .wb-overcast {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--ink) 8%, transparent),
        transparent 48%
      ),
      radial-gradient(
        ellipse 90% 40% at 50% 0%,
        color-mix(in srgb, var(--ink) 6%, transparent),
        transparent 75%
      );
  }

  .wb-haze {
    position: absolute;
    width: 68vw;
    height: 36vh;
    border-radius: 50%;
    pointer-events: none;
  }

  .wb-haze-a {
    left: -12vw;
    top: 4vh;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--ink) 7%, transparent),
      transparent 70%
    );
  }

  .wb-haze-b {
    right: -14vw;
    top: 22vh;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--ink) 6%, transparent),
      transparent 72%
    );
  }

  .wb-cloud {
    position: absolute;
    height: auto;
    opacity: var(--wb-cloud-alpha, 0.25);
  }

  .wb-cloud path {
    fill: color-mix(in srgb, var(--ink) 4.5%, transparent);
    stroke: var(--ink);
  }

  .wb-cloud-streak {
    position: absolute;
    height: auto;
    opacity: var(--wb-cloud-alpha, 0.16);
  }

  .wb-cloud-streak path {
    stroke: var(--ink);
  }

  /* Rain mist */
  .wb-rain-mist {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--ink) 7%, transparent),
      transparent 36%
    );
  }

  /* Snow mist */
  .wb-snow-mist {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--ink) 4%, transparent),
      transparent 32%
    );
  }

  @media (prefers-reduced-motion: no-preference) {
    .wb-star {
      animation: wb-star-twinkle var(--wb-twinkle-dur, 3.6s) ease-in-out var(--wb-twinkle-delay, 0s) infinite;
    }

    .wb-cloud {
      left: 0 !important;
      opacity: 0;
      animation: wb-cloud-pass var(--wb-cloud-dur, 44s) linear var(--wb-cloud-delay, 0s) infinite;
    }

    .wb-cloud-streak {
      left: 0 !important;
      opacity: 0;
      animation: wb-streak-pass var(--wb-cloud-dur, 38s) linear var(--wb-cloud-delay, 0s) infinite;
    }

    .wb-haze-a {
      animation: wb-haze-sway 30s ease-in-out infinite alternate;
    }

    .wb-haze-b {
      animation: wb-haze-sway 36s ease-in-out -14s infinite alternate;
    }
  }

  @keyframes wb-star-twinkle {
    0%,
    100% {
      opacity: 0.18;
    }
    45% {
      opacity: 0.56;
    }
  }

  @keyframes wb-cloud-pass {
    0% {
      transform: translate3d(-260px, 0, 0);
      opacity: 0;
    }
    8% {
      opacity: var(--wb-cloud-alpha, 0.25);
    }
    90% {
      opacity: var(--wb-cloud-alpha, 0.25);
    }
    100% {
      transform: translate3d(calc(100vw + 60px), 0, 0);
      opacity: 0;
    }
  }

  @keyframes wb-streak-pass {
    0% {
      transform: translate3d(-260px, 0, 0);
      opacity: 0;
    }
    8% {
      opacity: var(--wb-cloud-alpha, 0.16);
    }
    90% {
      opacity: var(--wb-cloud-alpha, 0.16);
    }
    100% {
      transform: translate3d(calc(100vw + 60px), 0, 0);
      opacity: 0;
    }
  }

  @keyframes wb-haze-sway {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(6vw, 0, 0);
    }
  }

  @media (max-width: 640px) {
    .wb-wide {
      display: none;
    }
  }
</style>

<script>
  import { initWeatherParticles } from './theme/weatherParticles';

  const canvases = new Map<HTMLCanvasElement, () => void>();

  function bootBackdrop() {
    for (const [el, stop] of canvases) {
      if (!el.isConnected) {
        stop();
        canvases.delete(el);
      }
    }
    document.querySelectorAll<HTMLCanvasElement>('[data-weather-canvas]').forEach((el) => {
      if (canvases.has(el)) return;
      canvases.set(el, initWeatherParticles(el));
    });
  }

  bootBackdrop();
  document.addEventListener('astro:page-load', bootBackdrop);
</script>
