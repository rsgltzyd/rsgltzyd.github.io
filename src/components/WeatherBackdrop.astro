  { left: '9%', top: '48%', size: 8, kind: 'cross', dur: '3.8s', delay: '-2.2s', wide: true },
  { left: '5%', top: '72%', size: 5, kind: 'dot', dur: '4.5s', delay: '-0.9s', wide: true },
  { left: '24%', top: '5%', size: 6, kind: 'dot', dur: '3.6s', delay: '-1.2s', wide: false },
  { left: '41%', top: '7%', size: 8, kind: 'cross', dur: '4.2s', delay: '-2.8s', wide: false },
  { left: '59%', top: '4%', size: 5, kind: 'dot', dur: '3.5s', delay: '-0.6s', wide: false },
  { left: '74%', top: '8%', size: 9, kind: 'cross', dur: '3.9s', delay: '-1.9s', wide: false },
  { left: '88%', top: '12%', size: 5, kind: 'dot', dur: '4.4s', delay: '-2.5s', wide: false },
  { left: '93%', top: '31%', size: 8, kind: 'cross', dur: '3.7s', delay: '-0.8s', wide: true },
  { left: '86%', top: '56%', size: 5, kind: 'dot', dur: '4.0s', delay: '-1.5s', wide: true },
  { left: '94%', top: '76%', size: 7, kind: 'cross', dur: '3.3s', delay: '-2.1s', wide: true },
  { left: '15%', top: '86%', size: 6, kind: 'dot', dur: '4.3s', delay: '-1.1s', wide: false },
  { left: '83%', top: '88%', size: 5, kind: 'dot', dur: '3.9s', delay: '-0.3s', wide: false },
] as const;

const BACKDROP_CLOUDS = [
  {
    d: 'M14 48 C14 31 29 22 46 25 C54 11 78 11 88 25 C104 22 118 32 116 48 C116 57 104 63 88 60 L34 60 C21 62 14 56 14 48 Z',
    left: '4%',
    top: '8%',
    w: 188,
