    wide: false,
  },
  {
    d: 'M12 40 C12 27 25 20 39 22 C46 10 68 10 76 22 C90 20 102 28 100 40 C100 48 90 52 76 50 L29 50 C19 52 12 47 12 40 Z',
    left: '64%',
    top: '12%',
    w: 224,
    alpha: 0.28,
    dur: '48s',
    delay: '-30s',
    wide: false,
  },
  {
    d: 'M10 34 C10 23 20 17 32 19 C38 9 56 9 63 19 C75 17 85 23 84 34 C84 40 75 44 63 42 L25 42 C16 44 10 40 10 34 Z',
    left: '34%',
