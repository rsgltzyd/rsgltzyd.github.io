---

<button
  type="button"
  class="back-to-top"
  data-back-to-top
  aria-label="回到顶部"
  aria-hidden="true"
  tabindex="-1"
  data-visible="false"
>
  ↑
</button>

<style>
  .back-to-top {
    position: fixed;
    right: 20px;
    bottom: 24px;
    z-index: 40;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.4px solid var(--line);
    border-radius: 16px 12px 18px 14px;
    background: transparent;
    color: var(--ink);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: opacity 200ms ease, transform 200ms ease, background-color 350ms ease, color 350ms ease, border-color 350ms ease;
  }

  .back-to-top[data-visible="true"] {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  html.game-window-open .back-to-top {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }
</style>

<script>
  function initBackToTop() {
    const btn = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
    if (!btn) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches === true;

    const onScroll = () => {
      const y = window.scrollY || document.documentElement.scrollTop || 0;
      const threshold = Math.min(400, Math.max(280, window.innerHeight * 0.85));
      const visible = y > threshold && !document.documentElement.classList.contains('game-window-open');
      btn.dataset.visible = visible ? 'true' : 'false';
      btn.setAttribute('aria-hidden', visible ? 'false' : 'true');
      btn.tabIndex = visible ? 0 : -1;
    };

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    });

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }

  initBackToTop();
  document.addEventListener('astro:page-load', initBackToTop);
</script>
