---
import Figure from './figure/Figure.astro';
---

<section class="hero-section home-hero" aria-labelledby="hero-title">
  <div class="hero-content">
    <div class="hero-copy">
      <div class="hero-vol ink-muted">VOL. 00 — 首页</div>
      <h1 id="hero-title" class="hero-title">
        做有趣的<br class="hero-title-break" />
        <span class="hero-title-ending">
          东西。
          <svg aria-hidden="true" class="hero-title-underline" preserveAspectRatio="none" viewBox="0 0 200 10">
            <path d="M2 6 Q25 2 50 5 T100 5 T150 6 T198 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.4"></path>
          </svg>
        </span>
      </h1>
      <p class="hero-desc">简简单单，做一些事儿，游戏人生。</p>
    </div>
    <Figure />
  </div>
</section>

<style>
  .hero-section {
    padding: clamp(36px, 8vw, 72px) 0 clamp(48px, 9vw, 88px);
    width: 100%;
  }

  .hero-content {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    width: 100%;
  }

  .hero-copy {
    flex: 1 1 300px;
    min-width: 0;
  }

  .hero-vol {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 2px;
    margin-bottom: 18px;
  }

  .hero-title {
    margin: 0;
    font-size: clamp(38px, 8vw, 60px);
    line-height: 1.12;
    font-weight: 600;
    letter-spacing: 2px;
  }

  .hero-title-ending {
    display: inline-block;
    position: relative;
  }

  .hero-title-underline {
    display: block;
    width: 100%;
    height: 10px;
    color: var(--ink);
  }

  .hero-desc {
    margin: 22px 0 0;
    max-width: 380px;
    font-size: 16px;
    line-height: 1.8;
    color: var(--secondary);
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 24px 0 28px;
    }

    .hero-content {
      gap: 16px;
    }

    .hero-vol {
      margin-bottom: 10px;
      font-size: 11px;
    }

    .hero-title {
      font-size: clamp(30px, 8.5vw, 34px);
      letter-spacing: 0;
      width: 100%;
      max-width: none;
    }

    .hero-title-break {
      display: none;
    }

    .hero-title-ending {
      width: 3em;
      max-width: 100%;
      vertical-align: top;
    }

    .hero-title-ending > svg {
      width: 100%;
    }

    .hero-desc {
      margin: 14px 0 0;
      font-size: 15px;
      line-height: 1.7;
    }
  }
</style>
