---
import Figure from './figure/Figure.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="band-index">01</p>
      <h1 id="hero-title">做有趣的东西。</h1>
      <p class="hero-lede">把想做的东西留在一份小杂志里。文章可以展开阅读。人物可以换场景。游戏可以在下面开始。</p>
      <p class="hero-actions">
        <a href="/#game">去游戏区</a>
        <a href="/#articles">去文章</a>
      </p>
    </div>
    <Figure />
  </div>
</section>
