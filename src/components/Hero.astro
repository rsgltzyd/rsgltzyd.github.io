---
import Figure from './figure/Figure.astro';
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="hero-content">
    <div class="hero-copy">
      <div class="hero-vol ink-muted">VOL. 00 — 首页</div>
      <h1 id="hero-title" class="hero-title">
        做有趣的<br class="hero-title-br" />
        <span class="hero-title-accent">
          东西。
          <svg aria-hidden="true" class="hero-title-underline" preserveAspectRatio="none" viewBox="0 0 100 8">
            <path d="M2 5 Q25 1 50 5 T98 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6" vector-effect="non-scaling-stroke"></path>
          </svg>
        </span>
      </h1>
      <p class="hero-desc">用几条线画画，做能玩的小东西，也写一点关于设计与留白的文字。先玩一局，再慢慢读。</p>
    </div>
    <div class="hero-figure-wrap">
      <Figure />
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: clamp(28px, 4.5vw, 52px) 0 clamp(36px, 7vw, 64px);
    width: 100%;
  }

  .hero-content {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    width: 100%;
  }

  .hero-copy {
    flex: 1 1 300px;
    min-width: 0;
  }

  .hero-vol {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 2px;
    margin-bottom: 14px;
  }

  .hero-title {
    margin: 0;
    font-size: clamp(32px, 5.5vw, 56px);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: 2px;
  }

  .hero-title-accent {
    display: inline-block;
    position: relative;
  }

  .hero-title-underline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    width: 100%;
    height: 8px;
    color: var(--ink);
    display: block;
  }

  .hero-desc {
    margin: 20px 0 0;
    max-width: 400px;
    font-size: 15px;
    line-height: 1.75;
    color: var(--secondary);
  }

  .hero-figure-wrap {
    flex: 1 1 280px;
    min-width: 0;
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 16px 0 24px;
    }

    .hero-content {
      gap: 16px;
    }

    .hero-vol {
      margin-bottom: 6px;
      font-size: 11px;
    }

    .hero-title {
      font-size: clamp(26px, 7.5vw, 36px);
    }

    .hero-title-br {
      display: none;
    }

    .hero-desc {
      margin: 10px 0 0;
      font-size: 14px;
      line-height: 1.6;
    }

    .hero-figure-wrap {
      flex: 1 1 auto;
      width: 100%;
      max-width: 320px;
      margin: 0 auto;
    }
  }
</style>
