---
import { GAME_LIST } from './controller';
import '../../styles/games.css';

interface Props {
  id: string;
}

const { id } = Astro.props;
const game = GAME_LIST.find((item) => item.id === id);
if (!game) {
  throw new Error(`Unknown game: ${id}`);
}
---

<div class="journal-games" data-game-deck>
  <div class="game-frame" data-game-frame data-game-id={game.id} tabindex="0">
    <div class="game-topbar">
      <span class="game-score" data-game-score>得分 000</span>
      <span class="game-best ink-muted" data-game-best>最佳 000</span>
      <span class="game-topbar-spacer"></span>
      <div class="game-topbar-actions">
        <button type="button" class="game-sound-btn" data-game-action="sound" aria-label="声音开关" title="静音 / 开启声音">🔊 声音</button>
        <button type="button" class="pill-btn primary game-action-btn" data-game-action="toggle">开始</button>
      </div>
    </div>

    <div class:list={['game-stage-wrap', game.aspectHeight === 240 && 'aspect-240']} data-game-stage>
      <canvas data-game-canvas width="360" height={game.aspectHeight} tabindex="0" aria-label={game.hint}></canvas>
      <div class="game-dom-overlay" data-game-dom-overlay>
        <div class="game-dom-hint" data-game-dom-hint>{game.hint}</div>
      </div>
    </div>

    <div class="game-touch-controls" data-game-touch-controls>
      {game.kind === 'drag-x' ? (
        <>
          <button type="button" class="game-touch-btn" data-dir="left" aria-label="向左">←</button>
          <button type="button" class="game-touch-btn" data-dir="right" aria-label="向右">→</button>
        </>
      ) : (
        <>
          <button type="button" class="game-touch-btn" data-dir="left" aria-label="向左">←</button>
          <button type="button" class="game-touch-btn" data-dir="up" aria-label="向上">↑</button>
          <button type="button" class="game-touch-btn" data-dir="down" aria-label="向下">↓</button>
          <button type="button" class="game-touch-btn" data-dir="right" aria-label="向右">→</button>
        </>
      )}
    </div>
  </div>
</div>

<script>
  import { initGame } from './controller';

  const frame = document.querySelector('[data-game-frame]');
  const id = frame?.getAttribute('data-game-id');
  if (frame instanceof HTMLElement && id) initGame(frame, id);
</script>
