---
import ThemeSky from './ThemeSky.astro';
---

<header class="masthead journal-header">
  <ThemeSky />
  <div class="masthead-header journal-header-inner">
    <div class="brand">
      <a class="wordmark" href="/#home" data-nav-view="home" aria-label="雨霖铃，回到首页">
        <span class="wordmark-text">雨霖铃</span>
        <svg aria-hidden="true" class="wordmark-wave" viewBox="0 0 200 10" preserveAspectRatio="none">
          <path d="M2 6 Q25 2 50 5 T100 5 T150 6 T198 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
      </a>
    </div>

    <nav class="masthead-nav" aria-label="站点导航">
      <a href="/#game" class="nav-item" data-nav-view="game">
        <span class="nav-number">01 </span>游戏
      </a>
      <a href="/#about" class="nav-item" data-nav-view="about">
        <span class="nav-number">02 </span>关于
      </a>

      <div class="theme-switch desktop-theme" role="group" aria-label="明暗模式">
        <button type="button" data-theme-choice="light" aria-pressed="false">浅色</button>
        <button type="button" data-theme-choice="dark" aria-pressed="true">深色</button>
        <button type="button" data-theme-choice="auto" aria-pressed="false">自动</button>
      </div>

      <div class="mobile-theme" data-mobile-theme>
        <button
          type="button"
          class="mobile-theme-trigger"
          data-theme-menu-trigger
          aria-label="切换主题，当前深色"
          aria-expanded="false"
          aria-controls="mobile-theme-options"
        >
          <span data-theme-menu-label>深色 ▾</span>
        </button>
        <div id="mobile-theme-options" class="mobile-theme-options" data-theme-menu role="group" aria-label="选择明暗模式" hidden>
          <button type="button" data-theme-choice="light" aria-pressed="false">浅色</button>
          <button type="button" data-theme-choice="dark" aria-pressed="true">深色</button>
          <button type="button" data-theme-choice="auto" aria-pressed="false">自动</button>
        </div>
      </div>
    </nav>
  </div>

  <div class="masthead-rule" aria-hidden="true">
    <svg class="line-svg" preserveAspectRatio="none" viewBox="0 0 200 10" width="100%">
      <path d="M2 6 Q25 2 50 5 T100 5 T150 6 T198 4" fill="none" stroke="var(--line)" stroke-width="1.4" stroke-linecap="round"></path>
    </svg>
  </div>
</header>

<style>
  .masthead {
    position: relative;
    z-index: 2;
    /* Visible so the mobile theme menu can hang below the rule.
       The sky clips itself. */
    overflow: visible;
    width: 100%;
    padding: 0;
    min-height: 0;
  }

  .masthead-header {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 24px;
    min-height: 38px;
  }

  .brand .wordmark {
    display: inline-block;
    text-decoration: none;
    color: var(--ink);
    text-align: left;
  }

  .wordmark-text {
    display: block;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 6px;
    line-height: 1.2;
  }

  .wordmark-wave {
    width: 78px;
    height: 10px;
    display: block;
    margin-top: 2px;
    color: var(--ink);
  }

  .masthead-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 22px;
  }

  .nav-item {
    color: var(--secondary);
    font-size: 14px;
    font-weight: 400;
    padding: 4px 0;
    text-decoration: none;
    border-radius: 0;
  }

  .nav-item.active {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1.5px;
  }

  .theme-switch {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 3px;
    background: var(--surface);
    position: relative;
    z-index: 2;
  }

  .theme-switch button {
    border: none;
    border-radius: 10px;
    padding: 3px 10px;
    cursor: pointer;
    font-size: 13px;
    background: transparent;
    color: var(--secondary);
    transition: background-color 280ms ease, color 280ms ease, transform 160ms ease;
  }

  .theme-switch button:active {
    transform: scale(0.96);
  }

  .theme-switch button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
    font-weight: 500;
  }

  .mobile-theme {
    display: none;
    position: relative;
    min-width: 0;
  }

  .mobile-theme-trigger {
    width: 100%;
    min-height: 40px;
    padding: 6px 4px;
    border: 1px solid var(--line);
    border-radius: 14px 18px 12px 16px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font-size: 14px;
  }

  .mobile-theme-options {
    position: absolute;
    /* Nav row, then the 10px rule margin and the 10px rule. */
    top: calc(100% + 22px);
    right: 0;
    width: max(140px, 100%);
    padding: 4px;
    z-index: 30;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 12px;
    display: grid;
    gap: 4px;
  }

  .mobile-theme-options[hidden] {
    display: none;
  }

  .mobile-theme-options > button {
    min-height: 44px;
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }

  .mobile-theme-options > button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .masthead-rule {
    width: 100%;
    height: 10px;
    margin-top: 14px;
  }

  .masthead-rule .line-svg {
    display: block;
    width: 100%;
    height: 10px;
  }

  @media (max-width: 640px) {
    .masthead-header {
      gap: 8px;
      min-height: 0;
    }

    .brand .wordmark-text {
      font-size: 18px;
      letter-spacing: 3px;
    }

    .wordmark-wave {
      width: 60px;
      height: 7px;
      margin-top: 1px;
    }

    .masthead-nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr)) minmax(72px, 0.9fr);
      width: 100%;
      gap: 2px 4px;
      align-items: stretch;
    }

    .nav-item {
      min-height: 36px;
      padding: 4px 2px;
      font-size: 14px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .mobile-theme-trigger {
      min-height: 36px;
      padding: 4px;
      border-radius: 12px 16px 10px 14px;
      font-size: 13px;
    }

    .nav-number {
      display: none;
    }

    .desktop-theme {
      display: none !important;
    }

    .mobile-theme {
      display: block;
    }

    .masthead-rule {
      margin-top: 8px;
    }
  }
</style>

<script>
  import { initThemeController } from './theme/ThemeController';

  initThemeController();
</script>
