---
import ThemeSky from './ThemeSky.astro';

---

<header class="masthead journal-header" transition:persist="masthead">
  <div class="masthead-header journal-header-inner">
    <div class="brand">
      <a class="wordmark" href="/#home" data-nav-view="home" aria-label="雨霖铃，回到首页">
        <span class="wordmark-text">雨霖铃</span>
        <svg aria-hidden="true" class="wordmark-wave" viewBox="0 0 200 10" preserveAspectRatio="none">
          <path d="M2 6 Q25 2 50 5 T100 5 T150 6 T198 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>
        </svg>
      </a>
      <ThemeSky />
    </div>
  </div>

  <div class="masthead-rule" aria-hidden="true"></div>
</header>

<style>
  .masthead {
    position: relative;
    z-index: 2;
    /* Visible so the mobile theme menu can hang below the rule.
       The sky clips itself. */
    overflow: visible;
    width: 100%;
    padding: 0;
    min-height: 0;
  }

  .masthead-header {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 24px;
    min-height: 38px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }

  .brand .wordmark {
    display: inline-block;
    text-decoration: none;
    color: var(--ink);
    text-align: left;
  }

  .wordmark-text {
    display: block;
    font-family: var(--serif);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 6px;
    line-height: 1.2;
  }

  .wordmark-wave {
    width: 78px;
    height: 10px;
    display: block;
    margin-top: 2px;
    color: var(--ink);
  }

  .masthead-rule {
    width: 100%;
    height: 5px;
    margin-top: 14px;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 640px) {
    .masthead-header {
      gap: 8px;
      min-height: 0;
    }

    .brand {
      gap: 10px;
    }

    .brand .wordmark-text {
      font-size: 21px;
      letter-spacing: 4px;
    }

    .wordmark-wave {
      width: 60px;
      height: 7px;
      margin-top: 1px;
    }

    .masthead-rule {
      margin-top: 8px;
    }
  }
</style>

<script>
  import { initThemeController } from './theme/ThemeController';

  initThemeController();
</script>
