---
const SUN_RAYS = [
  'M24 12.5 L24 7.5',
  'M32.1 15.9 L35.7 12.3',
  'M35.5 24 L40.5 24',
  'M32.1 32.1 L35.7 35.7',
  'M24 35.5 L24 40.5',
  'M15.9 32.1 L12.3 35.7',
  'M12.5 24 L7.5 24',
  'M15.9 15.9 L12.3 12.3',
];

const STAR_SPOTS = [
  { left: '16%', top: '30%', size: 8, kind: 'cross', dur: '2.6s', delay: '-0.3s' },
  { left: '34%', top: '60%', size: 5, kind: 'dot', dur: '3.2s', delay: '-1.4s' },
  { left: '44%', top: '24%', size: 7, kind: 'cross', dur: '2.2s', delay: '-1.9s' },
  { left: '84%', top: '22%', size: 5, kind: 'dot', dur: '3.0s', delay: '-0.8s' },
] as const;

const RAIN_DROPS = [
  { d: 'M16 14 L13 24', dur: '0.95s', delay: '0s' },
  { d: 'M25 16 L22 26', dur: '1.1s', delay: '-0.45s' },
  { d: 'M34 14 L31 24', dur: '0.9s', delay: '-0.25s' },
  { d: 'M43 16 L40 26', dur: '1.05s', delay: '-0.7s' },
  { d: 'M53 15 L50 25', dur: '1s', delay: '-0.15s' },
] as const;

const SNOW_FLAKES = [
  { cx: 15, cy: 16, r: 1.15, dur: '2.6s', delay: '0s' },
  { cx: 26, cy: 20, r: 1.0, dur: '3.1s', delay: '-1.1s' },
  { cx: 36, cy: 15, r: 1.2, dur: '2.8s', delay: '-0.6s' },
  { cx: 46, cy: 21, r: 0.95, dur: '3.3s', delay: '-1.8s' },
  { cx: 56, cy: 17, r: 1.1, dur: '2.7s', delay: '-0.9s' },
] as const;
---

<button
  type="button"
  class="theme-sky"
  data-theme-sky
  data-weather-cycle
  data-weather="clear"
  data-anim="idle"
  data-paused="false"
  data-previewing="false"
  aria-label="夜刊 · 晴，点击预览天气"
  title="点击切换天气预览（晴 / 阴 / 微雨 / 微雪）"
>
  <span class="sky-window" aria-hidden="true">
    <span class="sky-day sky-layer-out">
      <svg class="sky-cloud-far" viewBox="0 0 60 32" aria-hidden="true">
        <path
          d="M8 23 C8 16 14 12 22 14 C25 8 36 8 40 14 C47 13 53 17 52 23 C52 26 47 28 40 27 L18 27 C12 28 8 26 8 23 Z"
          stroke-width="1.05"
          stroke-linecap="round"
          stroke-linejoin="round"
          vector-effect="non-scaling-stroke"
        ></path>
      </svg>

      <svg class="theme-sky-sun theme-sky-body sky-hidden" viewBox="0 0 48 48" data-sky-sun>
        <g class="sun-rays">
          {SUN_RAYS.map((d) => (
            <path d={d} stroke-width="1.25" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>
          ))}
        </g>
        <circle
          cx="24"
          cy="24"
          r="7.5"
          stroke-width="1.25"
          vector-effect="non-scaling-stroke"
        ></circle>
      </svg>

      <svg class="sky-cloud-near" viewBox="0 0 80 42" aria-hidden="true">
        <path
          d="M10 31 C10 21 19 16 28 18 C32 9 47 9 52 18 C61 16 69 22 68 31 C68 36 61 39 52 38 L22 38 C14 39 10 35 10 31 Z"
          stroke-width="1.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          vector-effect="non-scaling-stroke"
        ></path>
      </svg>
    </span>

    <span class="sky-night sky-layer-in">
      <span class="sky-stars">
        {STAR_SPOTS.map((s) => (
          <span
            class="theme-sky-star"
            style={`left: ${s.left}; top: ${s.top}; --twinkle-dur: ${s.dur}; --twinkle-delay: ${s.delay};`}
          >
            <svg viewBox="0 0 12 12" width={s.size} height={s.size}>
              {s.kind === 'cross' ? (
                <path
                  d="M6 1.5 L6 10.5 M1.5 6 L10.5 6"
                  fill="none"
                  stroke-width="1.15"
                  stroke-linecap="round"
                  vector-effect="non-scaling-stroke"
                ></path>
              ) : (
                <circle cx="6" cy="6" r="1.4" class="star-dot"></circle>
              )}
            </svg>
          </span>
        ))}
      </span>

      <svg class="sky-night-mist" viewBox="0 0 70 20" aria-hidden="true">
        <path
          d="M4 15 Q16 9 28 14 T52 13 Q60 11 66 15"
          fill="none"
          stroke-width="1.05"
          stroke-linecap="round"
          vector-effect="non-scaling-stroke"
        ></path>
      </svg>

      <svg class="theme-sky-moon theme-sky-body sky-rest" viewBox="0 0 48 48" data-sky-moon>
        <path
          d="M32 10 C15 7 9 32 27 38 C32 39 36 37 38 34 C24 36 18 20 32 10 Z"
          stroke-width="1.3"
          stroke-linecap="round"
          stroke-linejoin="round"
          vector-effect="non-scaling-stroke"
        ></path>
      </svg>
    </span>

    <svg class="sky-overcast-cloud" viewBox="0 0 72 32" aria-hidden="true">
      <path
        class="overcast-back"
        d="M34 15 C34 10 39 7 44 8.5 C46.5 4.5 53.5 4.5 56 8.5 C61 7.5 65 10.5 64 15 C64 18 60 19.5 55 19 L40 19 C36 19.5 34 17.5 34 15 Z"
        stroke-width="1.1"
        stroke-linecap="round"
        stroke-linejoin="round"
        vector-effect="non-scaling-stroke"
      ></path>
      <path
        class="overcast-front"
        d="M8 22 C8 15 15 11.5 22 13 C25 7.5 35.5 7.5 39 13 C45 11.5 51 15.5 50 22 C50 25.5 45 27.5 39 27 L17 27 C11 27.5 8 25 8 22 Z"
        stroke-width="1.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        vector-effect="non-scaling-stroke"
      ></path>
    </svg>

    <svg class="sky-precip sky-rain" viewBox="0 0 72 32" aria-hidden="true">
      {RAIN_DROPS.map((drop) => (
        <path
          class="rain-streak"
          d={drop.d}
          stroke-width="1"
          stroke-linecap="round"
          vector-effect="non-scaling-stroke"
          style={`--drop-dur: ${drop.dur}; --drop-delay: ${drop.delay};`}
        ></path>
      ))}
    </svg>

    <svg class="sky-precip sky-snow" viewBox="0 0 72 32" aria-hidden="true">
      {SNOW_FLAKES.map((flake) => (
        <circle
          class="snow-flake"
          cx={flake.cx}
          cy={flake.cy}
          r={flake.r}
          style={`--flake-dur: ${flake.dur}; --flake-delay: ${flake.delay};`}
        ></circle>
      ))}
    </svg>
  </span>

  <span class="sky-caption" data-sky-caption>夜刊 · 晴</span>
</button>

<style>
  .theme-sky {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    padding: 0;
    margin: 0;
    background: transparent;
    border: none;
    border-radius: 2px;
    color: var(--ink);
    cursor: pointer;
    overflow: visible;
  }

  .sky-window {
    position: relative;
    display: block;
    flex-shrink: 0;
    width: 72px;
    height: 32px;
    background: var(--paper);
    border: 1px solid var(--ink);
    border-radius: 2px;
    box-shadow:
      inset 0 0 0 2px var(--paper),
      inset 0 0 0 3px var(--rule);
    overflow: hidden;
    pointer-events: none;
    transition: border-color 180ms ease, background-color 350ms ease, transform 160ms ease;
  }

  .sky-caption {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.8px;
    line-height: 1;
    color: var(--muted);
    white-space: nowrap;
    transition: color 180ms ease;
  }

  .theme-sky:hover .sky-window {
    transform: translateY(-1px);
  }

  .theme-sky:hover .sky-caption {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 4px;
  }

  .theme-sky:active .sky-window {
    transform: scale(0.97);
  }

  .theme-sky[data-previewing="true"] .sky-window {
    box-shadow:
      inset 0 0 0 2px var(--paper),
      inset 0 0 0 3px var(--ink);
  }

  .theme-sky[data-previewing="true"] .sky-caption {
    color: var(--secondary);
  }

  .sky-day,
  .sky-night {
    position: absolute;
    inset: 0;
    display: block;
    pointer-events: none;
  }

  .sky-layer-in {
    opacity: 1;
    visibility: visible;
  }

  .sky-layer-out {
    opacity: 0;
    visibility: hidden;
  }

  .sky-cloud-far {
    position: absolute;
    left: 6px;
    top: 4px;
    width: 20px;
    height: 11px;
    opacity: 0.55;
    transition: opacity 260ms ease;
  }

  .sky-cloud-near {
    position: absolute;
    left: 15px;
    bottom: 2px;
    width: 34px;
    height: 18px;
    z-index: 2;
    transition: transform 260ms ease;
  }

  .sky-cloud-far path,
  .sky-cloud-near path {
    fill: var(--paper);
    stroke: var(--ink);
  }

  .sky-night-mist {
    position: absolute;
    left: 7px;
    bottom: 3px;
    width: 26px;
    height: 10px;
    opacity: 0.42;
    transition: opacity 260ms ease;
  }

  .sky-night-mist path {
    stroke: var(--ink);
  }

  .sky-stars {
    position: absolute;
    inset: 0;
    display: block;
    pointer-events: none;
    transition: opacity 260ms ease;
  }

  .theme-sky-star {
    position: absolute;
    transform: translate(-50%, -50%);
    opacity: 0.68;
    line-height: 0;
  }

  .theme-sky-star path {
    fill: none;
    stroke: var(--ink);
  }

  .theme-sky-star .star-dot {
    fill: var(--ink);
  }

  .theme-sky-body {
    position: absolute;
    right: 8px;
    top: 3px;
    width: 22px;
    height: 22px;
    overflow: visible;
    z-index: 1;
  }

  .theme-sky-moon {
    right: 11px;
    top: 4px;
    width: 20px;
    height: 20px;
  }

  .theme-sky-sun circle,
  .theme-sky-moon path {
    fill: var(--paper);
    stroke: var(--ink);
  }

  .theme-sky-sun path {
    fill: none;
    stroke: var(--ink);
  }

  .sun-rays {
    transform-box: view-box;
    transform-origin: 24px 24px;
  }

  .theme-sky-moon.sky-rest,
  .theme-sky-sun.sky-rest {
    transform: translate(var(--sky-x, 0px), var(--sky-y, 0px)) scale(var(--sky-s, 1));
    opacity: 0.94;
    visibility: visible;
  }

  .theme-sky-moon.sky-hidden,
  .theme-sky-sun.sky-hidden {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none;
    transform: translate(0, 14px) scale(0.76);
  }

  /* Weather-specific layering inside the vignette */
  .sky-overcast-cloud {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-6px);
    transition: opacity 280ms ease, transform 320ms ease, visibility 0s linear 280ms;
  }

  .sky-overcast-cloud .overcast-back {
    fill: var(--paper);
    stroke: var(--ink);
    opacity: 0.78;
  }

  .sky-overcast-cloud .overcast-front {
    fill: var(--paper);
    stroke: var(--ink);
  }

  .theme-sky[data-weather="cloudy"] .sky-overcast-cloud,
  .theme-sky[data-weather="rain"] .sky-overcast-cloud,
  .theme-sky[data-weather="snow"] .sky-overcast-cloud {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    transition: opacity 280ms ease, transform 320ms ease, visibility 0s linear 0s;
  }

  .sky-precip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    z-index: 3;
    transition: opacity 240ms ease, visibility 0s linear 240ms;
  }

  .rain-streak {
    fill: none;
    stroke: var(--ink);
    opacity: 0.55;
  }

  .snow-flake {
    fill: var(--ink);
    opacity: 0.72;
  }

  .theme-sky[data-weather="rain"] .sky-rain,
  .theme-sky[data-weather="snow"] .sky-snow {
    opacity: 1;
    visibility: visible;
    transition: opacity 240ms ease, visibility 0s linear 0s;
  }

  .theme-sky[data-weather="cloudy"] .sky-cloud-far,
  .theme-sky[data-weather="rain"] .sky-cloud-far,
  .theme-sky[data-weather="snow"] .sky-cloud-far {
    opacity: 0.85;
  }

  .theme-sky[data-weather="cloudy"] .sky-night-mist,
  .theme-sky[data-weather="rain"] .sky-night-mist,
  .theme-sky[data-weather="snow"] .sky-night-mist {
    opacity: 0.72;
  }

  .theme-sky[data-weather="cloudy"] .sky-stars {
    opacity: 0.3;
  }

  .theme-sky[data-weather="rain"] .sky-stars,
  .theme-sky[data-weather="snow"] .sky-stars {
    opacity: 0.2;
  }

  .theme-sky[data-weather="cloudy"] .theme-sky-sun.sky-rest,
  .theme-sky[data-weather="cloudy"] .theme-sky-moon.sky-rest {
    opacity: 0.65;
  }

  .theme-sky[data-weather="rain"] .theme-sky-sun.sky-rest,
  .theme-sky[data-weather="rain"] .theme-sky-moon.sky-rest,
  .theme-sky[data-weather="snow"] .theme-sky-sun.sky-rest,
  .theme-sky[data-weather="snow"] .theme-sky-moon.sky-rest {
    opacity: 0.42;
  }

  .theme-sky[data-paused="true"] * {
    animation-play-state: paused !important;
  }

  /* Markup defaults to night. Before the sky script runs, sync with
     html[data-theme="light"] so a daytime header never flashes the moon. */
  :global(html[data-theme="light"]) .theme-sky:not([data-sky-ready]) .sky-day.sky-layer-out {
    opacity: 1;
    visibility: visible;
    transition: none;
  }

  :global(html[data-theme="light"]) .theme-sky:not([data-sky-ready]) .sky-night.sky-layer-in {
    opacity: 0;
    visibility: hidden;
    transition: none;
  }

  :global(html[data-theme="light"]) .theme-sky:not([data-sky-ready]) .theme-sky-sun.sky-hidden {
    opacity: 0.94 !important;
    visibility: visible !important;
    transform: translate(var(--sky-x, 0px), var(--sky-y, 0px)) scale(var(--sky-s, 1));
  }

  :global(html[data-theme="light"]) .theme-sky:not([data-sky-ready]) .theme-sky-moon.sky-rest {
    opacity: 0 !important;
    visibility: hidden !important;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sky-day,
    .sky-night {
      transition: opacity 420ms ease, visibility 0s linear 0s;
    }

    .sky-layer-out {
      transition: opacity 420ms ease, visibility 0s linear 420ms;
    }

    .theme-sky-moon.sky-rest,
    .theme-sky-sun.sky-rest {
      transition: transform 700ms ease, opacity 350ms ease;
    }

    .sky-cloud-far {
      animation: sky-cloud-far-drift 16s ease-in-out infinite alternate;
    }

    .sky-cloud-near {
      animation: sky-cloud-near-drift 12s ease-in-out -3s infinite alternate;
    }

    .theme-sky[data-weather="cloudy"] .overcast-front,
    .theme-sky[data-weather="rain"] .overcast-front,
    .theme-sky[data-weather="snow"] .overcast-front {
      animation: sky-cloud-near-drift 14s ease-in-out infinite alternate;
    }

    .theme-sky[data-weather="cloudy"] .overcast-back,
    .theme-sky[data-weather="rain"] .overcast-back,
    .theme-sky[data-weather="snow"] .overcast-back {
      animation: sky-cloud-far-drift 18s ease-in-out -4s infinite alternate;
    }

    .theme-sky-star {
      animation: sky-star-twinkle var(--twinkle-dur, 2.5s) ease-in-out var(--twinkle-delay, 0s) infinite;
    }

    .sun-rays {
      animation: sun-rays-spin 60s linear infinite;
    }

    .theme-sky[data-weather="rain"] .rain-streak {
      animation: sky-rain-fall var(--drop-dur, 1s) linear var(--drop-delay, 0s) infinite;
    }

    .theme-sky[data-weather="snow"] .snow-flake {
      animation: sky-snow-drift var(--flake-dur, 2.8s) ease-in-out var(--flake-delay, 0s) infinite;
    }

    .theme-sky-moon.arc-rise,
    .theme-sky-moon.arc-set,
    .theme-sky-sun.arc-rise,
    .theme-sky-sun.arc-set {
      will-change: transform, opacity;
    }

    .theme-sky-moon.arc-rise {
      animation: theme-arc-rise 0.85s cubic-bezier(0.33, 0.1, 0.25, 1) both;
    }

    .theme-sky-moon.arc-set {
      animation: theme-arc-set 0.78s cubic-bezier(0.4, 0.05, 0.35, 1) both;
    }

    .theme-sky-sun.arc-rise {
      animation: theme-arc-rise 0.88s cubic-bezier(0.33, 0.1, 0.25, 1) 0.04s both;
    }

    .theme-sky-sun.arc-set {
      animation: theme-arc-set 0.76s cubic-bezier(0.4, 0.05, 0.35, 1) both;
    }
  }

  @keyframes theme-arc-rise {
    0% {
      transform: translate(-8px, 18px) scale(0.76);
      opacity: 0;
    }
    30% {
      opacity: 0.94;
    }
    100% {
      transform: translate(var(--sky-x, 0px), var(--sky-y, 0px)) scale(var(--sky-s, 1));
      opacity: 0.94;
    }
  }

  @keyframes theme-arc-set {
    0% {
      transform: translate(var(--sky-x, 0px), var(--sky-y, 0px)) scale(var(--sky-s, 1));
      opacity: 0.94;
    }
    100% {
      transform: translate(8px, 18px) scale(0.74);
      opacity: 0;
    }
  }

  @keyframes sky-cloud-far-drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(4px);
    }
  }

  @keyframes sky-cloud-near-drift {
    from {
      transform: translateX(-2px);
    }
    to {
      transform: translateX(3px);
    }
  }

  @keyframes sky-star-twinkle {
    0%,
    100% {
      opacity: 0.32;
    }
    45% {
      opacity: 0.92;
    }
  }

  @keyframes sun-rays-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes sky-rain-fall {
    0% {
      transform: translate(2px, -7px);
      opacity: 0;
    }
    25% {
      opacity: 0.65;
    }
    80% {
      opacity: 0.5;
    }
    100% {
      transform: translate(-3px, 9px);
      opacity: 0;
    }
  }

  @keyframes sky-snow-drift {
    0% {
      transform: translate(0, -5px);
      opacity: 0;
    }
    30% {
      opacity: 0.8;
    }
    70% {
      transform: translate(2px, 4px);
      opacity: 0.7;
    }
    100% {
      transform: translate(-1px, 9px);
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    .theme-sky {
      gap: 7px;
    }

    .sky-window {
      width: 58px;
      height: 26px;
      border-radius: 2px;
    }

    .sky-caption {
      font-size: 10px;
      letter-spacing: 0.4px;
    }

    .sky-cloud-far {
      left: 4px;
      top: 3px;
      width: 16px;
      height: 9px;
    }

    .sky-cloud-near {
      left: 11px;
      bottom: 1px;
      width: 28px;
      height: 15px;
    }

    .theme-sky-body {
      right: 6px;
      top: 2px;
      width: 18px;
      height: 18px;
    }

    .theme-sky-moon {
      right: 8px;
      top: 3px;
      width: 17px;
      height: 17px;
    }

    .sky-night-mist {
      left: 5px;
      bottom: 2px;
      width: 21px;
      height: 8px;
    }
  }
</style>

<script>
  import {
    arcPoint,
    arcProgress,
    editionFromTime,
    editionLabel,
    localMinutes,
    msUntilNextMinute,
    shadeFromEdition,
    weatherLabel,
    type EditionId,
    type WeatherKind,
  } from './theme/clock';
  import { isWeatherKind } from './theme/weather';
  import type { ThemeChangeDetail } from './theme/ThemeController';

  function isEditionId(value: string | null): value is EditionId {
    return value === 'morning' || value === 'day' || value === 'evening' || value === 'night';
  }

  function initThemeSky(root: HTMLElement): () => void {
    const sunEl = root.querySelector<SVGElement>('[data-sky-sun]');
    const moonEl = root.querySelector<SVGElement>('[data-sky-moon]');
    const dayEl = root.querySelector<HTMLElement>('.sky-day');
    const nightEl = root.querySelector<HTMLElement>('.sky-night');
    const captionEl = root.querySelector<HTMLElement>('[data-sky-caption]');
    if (!sunEl || !moonEl || !dayEl || !nightEl) return () => {};
    const sun = sunEl;
    const moon = moonEl;
    const day = dayEl;
    const night = nightEl;

    const reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let reduced = reducedQuery.matches === true;
    let burstTo: 'light' | 'dark' | null = null;
    let burstTimer: number | null = null;
    let minuteTimer: number | null = null;
    let minuteTimeout: number | null = null;

    function readSnapshot(): {
      kind: 'light' | 'dark';
      edition: EditionId;
      weather: WeatherKind;
      previewing: boolean;
    } {
      const html = document.documentElement;
      const edAttr = html.getAttribute('data-edition');
      const edition = isEditionId(edAttr) ? edAttr : editionFromTime(localMinutes());
      const kind = shadeFromEdition(edition);
      const wAttr = html.getAttribute('data-weather');
      const weather: WeatherKind = isWeatherKind(wAttr) ? wAttr : 'clear';
      return {
        kind,
        edition,
        weather,
        previewing: root.dataset.previewing === 'true',
      };
    }

    let prevKind = readSnapshot().kind;
    let activeMinutes: number | null = null;

    function applyRestVars(kind: 'light' | 'dark', mins: number = activeMinutes ?? localMinutes()) {
      const pt = arcPoint(arcProgress(mins, kind));
      root.style.setProperty('--sky-x', `${pt.x.toFixed(2)}px`);
      root.style.setProperty('--sky-y', `${pt.y.toFixed(2)}px`);
      root.style.setProperty('--sky-s', pt.s.toFixed(3));
    }

    function setBodyClass(el: Element, next: string) {
      const states = ['sky-rest', 'sky-hidden', 'arc-rise', 'arc-set'];
      if (el.classList.contains(next) && states.every((name) => name === next || !el.classList.contains(name))) return;
      el.classList.remove('sky-rest', 'sky-hidden', 'arc-rise', 'arc-set');
      el.classList.add(next);
    }

    function paint(
      kind: 'light' | 'dark',
      edition: EditionId,
      weather: WeatherKind,
      previewing: boolean,
      animating: boolean,
      mins: number = activeMinutes ?? localMinutes(),
    ) {
      const toDark = kind === 'dark';
      applyRestVars(kind, mins);
      root.setAttribute('data-shade', kind);
      root.setAttribute('data-weather', weather);
      root.setAttribute('data-reduced', reduced ? 'true' : 'false');
      root.setAttribute('data-anim', animating && burstTo ? burstTo : 'idle');
      root.setAttribute('data-previewing', previewing ? 'true' : 'false');

      const baseLabel = `${editionLabel(edition)} · ${weatherLabel(weather)}`;
      if (captionEl) {
        captionEl.textContent = previewing ? `${baseLabel} · 预览` : baseLabel;
      }
      root.setAttribute(
        'aria-label',
        previewing ? `${baseLabel}（预览中），点击切换天气` : `${baseLabel}，点击预览天气`,
      );
      root.setAttribute(
        'title',
        previewing ? '预览模式：点击继续切换或恢复实时天气' : '点击切换天气预览（晴 / 阴 / 微雨 / 微雪）',
      );

      day.classList.toggle('sky-layer-in', !toDark);
      day.classList.toggle('sky-layer-out', toDark);
      night.classList.toggle('sky-layer-in', toDark);
      night.classList.toggle('sky-layer-out', !toDark);

      if (animating && burstTo) {
        const animToDark = burstTo === 'dark';
        setBodyClass(moon, animToDark ? 'arc-rise' : 'arc-set');
        setBodyClass(sun, animToDark ? 'arc-set' : 'arc-rise');
      } else {
        setBodyClass(moon, toDark ? 'sky-rest' : 'sky-hidden');
        setBodyClass(sun, toDark ? 'sky-hidden' : 'sky-rest');
      }
    }

    function onThemeEvent(event: Event) {
      const detail = (event as CustomEvent<ThemeChangeDetail>).detail;
      if (!detail) return;
      const { resolved: kind, edition, weather, minutes, previewing } = detail;
      activeMinutes = previewing ? minutes : null;

      if (kind === prevKind) {
        paint(kind, edition, weather, previewing, false, minutes);
        return;
      }
      prevKind = kind;
      if (reduced) {
        burstTo = null;
        paint(kind, edition, weather, previewing, false, minutes);
        return;
      }
      burstTo = kind;
      paint(kind, edition, weather, previewing, true, minutes);
      if (burstTimer !== null) window.clearTimeout(burstTimer);
      burstTimer = window.setTimeout(() => {
        burstTo = null;
        const snap = readSnapshot();
        paint(snap.kind, snap.edition, snap.weather, snap.previewing, false);
      }, 1100);
    }

    function onReduced(event: MediaQueryListEvent) {
      reduced = event.matches;
      const snap = readSnapshot();
      paint(snap.kind, snap.edition, snap.weather, snap.previewing, false);
    }

    function armMinuteClock() {
      if (minuteTimeout !== null) window.clearTimeout(minuteTimeout);
      if (minuteTimer !== null) window.clearInterval(minuteTimer);
      minuteTimeout = window.setTimeout(() => {
        applyRestVars(readSnapshot().kind);
        minuteTimer = window.setInterval(() => applyRestVars(readSnapshot().kind), 60_000);
      }, msUntilNextMinute());
    }

    let visibilityObserver: IntersectionObserver | null = null;
    if (typeof IntersectionObserver !== 'undefined') {
      visibilityObserver = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];
          if (!entry) return;
          root.dataset.paused = entry.isIntersecting ? 'false' : 'true';
        },
        { threshold: 0 },
      );
      visibilityObserver.observe(root);
    }

    root.dataset.skyReady = '1';
    const initial = readSnapshot();
    paint(initial.kind, initial.edition, initial.weather, initial.previewing, false);
    armMinuteClock();

    document.addEventListener('yl-theme-change', onThemeEvent);
    reducedQuery.addEventListener('change', onReduced);

    return () => {
      visibilityObserver?.disconnect();
      document.removeEventListener('yl-theme-change', onThemeEvent);
      reducedQuery.removeEventListener('change', onReduced);
      if (burstTimer !== null) window.clearTimeout(burstTimer);
      if (minuteTimeout !== null) window.clearTimeout(minuteTimeout);
      if (minuteTimer !== null) window.clearInterval(minuteTimer);
    };
  }

  const skies = new Map<HTMLElement, () => void>();

  function boot() {
    for (const [el, stop] of skies) {
      if (!el.isConnected) {
        stop();
        skies.delete(el);
      }
    }
    document.querySelectorAll<HTMLElement>('[data-theme-sky]').forEach((el) => {
      if (skies.has(el)) return;
      skies.set(el, initThemeSky(el));
    });
  }

  boot();
  document.addEventListener('astro:page-load', boot);
</script>
