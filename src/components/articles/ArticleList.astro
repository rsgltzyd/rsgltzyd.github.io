---
import { ARTICLES, type ArticleItem } from './data';

interface Props {
  isFeatured?: boolean;
  articles?: ArticleItem[];
}

const { isFeatured = false, articles = ARTICLES } = Astro.props;

const displayArticles = isFeatured ? articles.slice(0, 2) : articles;
const headingTitle = isFeatured ? '精选文章' : '文章';
const headingNote = isFeatured
  ? '演示文章，非真实发布'
  : `共 ${articles.length} 篇 · 演示文章，非真实发布`;
const sectionId = isFeatured ? 'articles' : 'articles-list';
---

<section id={sectionId} class="chapter-section articles-section" aria-labelledby={`${sectionId}-heading`}>
  <div class="chapter-head">
    <svg aria-hidden="true" class="line-svg" preserveAspectRatio="none" viewBox="0 0 200 10">
      <path d="M2 6 Q25 2 50 5 T100 5 T150 6 T198 4" fill="none" stroke="var(--line)" stroke-width="1.4" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>
    </svg>
    <div class="chapter-head-row">
      <span class="chapter-head-no">№ 02</span>
      <h2 id={`${sectionId}-heading`} class="chapter-head-title">{headingTitle}</h2>
      <span class="chapter-head-note">{headingNote}</span>
    </div>
  </div>

  <div class="articles-container" data-articles-container>
    {displayArticles.map((a) => (
      <article class="article-item" data-article-id={a.id}>
        <button
          type="button"
          class="article-trigger"
          aria-expanded="false"
          data-article-toggle
        >
          <span class="article-no">{a.no}</span>
          <span class="article-main">
            <span class="article-meta">{a.category} · 演示文章 · 约 {a.minutes} 分钟</span>
            <span class="article-title">{a.title}</span>
            <span class="article-dek">{a.description}</span>
          </span>
          <span class="article-action" data-article-action>阅读 →</span>
        </button>
        <div class="article-body" data-article-body hidden>
          <div class="article-prose">
            {a.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
          <p class="article-note">演示短文，用于展示阅读排版。演示文章，非真实发布。</p>
        </div>
      </article>
    ))}
  </div>

  {isFeatured && (
    <div class="articles-footer">
      <a href="/posts/" class="pill-btn all-articles-btn">全部文章 →</a>
    </div>
  )}
</section>

<style>
  .articles-section {
    margin-bottom: clamp(56px, 10vw, 96px);
  }

  .article-item {
    border-bottom: 1px solid var(--rule);
    transition: background-color 160ms ease;
    border-radius: 8px;
    padding: 0 8px;
  }

  .article-item:hover,
  .article-item:has(.article-trigger:hover) {
    background-color: var(--surface);
  }

  .article-trigger {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 22px 0;
    cursor: pointer;
    color: var(--ink);
    font-family: var(--sans);
    transition: opacity 120ms ease;
  }

  .article-trigger:hover .article-action {
    color: var(--ink);
  }

  .article-no {
    flex: 0 0 44px;
    font-family: var(--mono);
    font-size: 28px;
    line-height: 1;
    color: var(--muted);
  }

  .article-main {
    flex: 1 1 260px;
    min-width: 0;
  }

  .article-meta {
    display: block;
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .article-title {
    display: block;
    font-size: 21px;
    font-weight: 600;
    line-height: 1.4;
  }

  .article-dek {
    display: block;
    font-size: 15px;
    line-height: 1.7;
    color: var(--secondary);
    margin-top: 6px;
  }

  .article-action {
    align-self: center;
    font-size: 13px;
    color: var(--secondary);
    white-space: nowrap;
    transition: color 120ms ease;
  }

  .article-body {
    padding: 0 0 26px 68px;
    max-width: 620px;
    box-sizing: border-box;
  }

  @media (max-width: 560px) {
    .article-body {
      padding-left: 0;
    }
  }

  .article-prose p {
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 1.9;
    color: var(--ink);
  }

  .article-prose p:first-child {
    margin-top: 0;
  }

  .article-note {
    margin: 16px 0 0;
    font-size: 12px;
    color: var(--muted);
  }

  .articles-footer {
    margin-top: 24px;
  }

  .all-articles-btn {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    font-size: 14px;
    text-decoration: none;
  }
</style>

<script>
  function initArticles() {
    const containers = document.querySelectorAll('[data-articles-container]');
    containers.forEach((container) => {
      container.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;
        const trigger = target.closest<HTMLButtonElement>('[data-article-toggle]');
        if (!trigger) return;

        const item = trigger.closest<HTMLElement>('.article-item');
        if (!item) return;

        const body = item.querySelector<HTMLElement>('[data-article-body]');
        const action = item.querySelector<HTMLElement>('[data-article-action]');
        if (!body) return;

        const isOpen = trigger.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          trigger.setAttribute('aria-expanded', 'false');
          body.hidden = true;
          if (action) action.textContent = '阅读 →';
        } else {
          // Optional accordion close other open items in the same container
          container.querySelectorAll('.article-item').forEach((otherItem) => {
            if (otherItem !== item) {
              const otherTrigger = otherItem.querySelector<HTMLButtonElement>('[data-article-toggle]');
              const otherBody = otherItem.querySelector<HTMLElement>('[data-article-body]');
              const otherAction = otherItem.querySelector<HTMLElement>('[data-article-action]');
              if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
              if (otherBody) otherBody.hidden = true;
              if (otherAction) otherAction.textContent = '阅读 →';
            }
          });

          trigger.setAttribute('aria-expanded', 'true');
          body.hidden = false;
          if (action) action.textContent = '收起 ↑';
        }
      });
    });
  }

  initArticles();
  document.addEventListener('astro:after-swap', initArticles);
</script>
