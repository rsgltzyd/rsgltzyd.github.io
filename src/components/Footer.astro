---
import FooterSprite from './FooterSprite.astro';
---

<footer class="site-footer journal-footer">
  <FooterSprite />
  <div class="footer-rule" aria-hidden="true"></div>
</footer>

<style>
  .site-footer {
    padding: 0;
    width: 100%;
  }

  .footer-rule {
    width: 100%;
    height: 5px;
    border-top: 1px solid var(--line);
    border-bottom: 2px solid var(--ink);
  }

  @media (max-width: 640px) {
    .site-footer {
      padding-top: 0;
      padding-bottom: 0;
      margin: 0;
    }
  }
</style>
