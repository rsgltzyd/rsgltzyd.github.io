---
import { FIGURE_SCENES, GROUND_PATH, sceneItems } from './scenes';
import '../../styles/figure.css';

const first = FIGURE_SCENES[0];
const firstItems = sceneItems(first);
---

<figure class="figure-card scene-surface" data-figure>
  <div
    class="pose-stage"
    data-pose-stage
    style="position: relative; touch-action: pan-y; user-select: none;"
  >
    <button
      type="button"
      class="pose-nav pose-nav-prev"
      data-figure-delta="-1"
      aria-label="上一个角色"
    >
      ‹
    </button>
    <svg
      data-figure-svg
      viewBox="0 0 240 200"
      width="100%"
      role="img"
      aria-label={`简笔画：${first.label}`}
    >
      <path
        class="scene-ground"
        d={GROUND_PATH}
        fill="none"
        stroke-width="1.4"
        stroke-linecap="round"
      />
      <g
        class="scene-paths"
        data-figure-paths
        fill="none"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        {firstItems.map((item) =>
          item.kind === 'path' ? (
            <path d={item.d} pathLength="1" />
          ) : item.wrap ? (
            <g transform={item.wrap}>
              <g
                class={`figure-live ${item.className}`}
                style={[item.delay ? `--live-delay: ${item.delay}` : '', item.origin ? `transform-origin: ${item.origin}` : '']
                  .filter(Boolean)
                  .join('; ')}
              >
                {item.spin ? (
                  <animateTransform
                    attributeName="transform"
                    type="rotate"
                    from="0 0 0"
                    to="360 0 0"
                    dur={item.spin.dur}
                    repeatCount="indefinite"
                    begin="indefinite"
                  />
                ) : null}
                {item.paths.map((d, i) => (
                  <path d={d} pathLength="1">
                    {i === 0 && item.morph ? (
                      <animate
                        attributeName="d"
                        dur={item.morph.dur}
                        repeatCount="indefinite"
                        begin="indefinite"
                        calcMode="linear"
                        values={item.morph.values.join(';')}
                      />
                    ) : null}
                  </path>
                ))}
              </g>
            </g>
          ) : (
            <g
              class={`figure-live ${item.className}`}
              style={[item.delay ? `--live-delay: ${item.delay}` : '', item.origin ? `transform-origin: ${item.origin}` : '']
                .filter(Boolean)
                .join('; ')}
            >
              {item.spin ? (
                <animateTransform
                  attributeName="transform"
                  type="rotate"
                  from="0 0 0"
                  to="360 0 0"
                  dur={item.spin.dur}
                  repeatCount="indefinite"
                  begin="indefinite"
                />
              ) : null}
              {item.paths.map((d, i) => (
                <path d={d} pathLength="1">
                  {i === 0 && item.morph ? (
                    <animate
                      attributeName="d"
                      dur={item.morph.dur}
                      repeatCount="indefinite"
                      begin="indefinite"
                      calcMode="linear"
                      values={item.morph.values.join(';')}
                    />
                  ) : null}
                </path>
              ))}
            </g>
          ),
        )}
      </g>
    </svg>
    <button
      type="button"
      class="pose-nav pose-nav-next"
      data-figure-delta="1"
      aria-label="下一个角色"
    >
      ›
    </button>
  </div>
  <figcaption data-figure-caption>“{first.line}”</figcaption>
  <div class="figure-controls" role="group" aria-label="角色姿态">
    {FIGURE_SCENES.map((scene, i) => (
      <button
        type="button"
        class="figure-btn"
        data-scene={scene.id}
        aria-pressed={i === 0 ? 'true' : 'false'}
      >
        {scene.label}
      </button>
    ))}
  </div>
</figure>

<noscript>
  <style>
    .figure-card path[pathLength='1'] {
      stroke-dashoffset: 0 !important;
    }
  </style>
</noscript>

<script>
  import { initFigure } from './controller';

  const figures = new Map<HTMLElement, () => void>();

  function bootFigure() {
    for (const [el, stop] of figures) {
      if (!el.isConnected) {
        stop();
        figures.delete(el);
      }
    }
    document.querySelectorAll<HTMLElement>('[data-figure]').forEach((el) => {
      if (figures.has(el)) return;
      figures.set(el, initFigure(el));
    });
  }

  bootFigure();
  document.addEventListener('astro:page-load', bootFigure);
</script>
