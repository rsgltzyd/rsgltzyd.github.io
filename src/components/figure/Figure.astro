---
import { FIGURE_SCENES, GROUND_PATH } from './scenes';
import '../../styles/figure.css';

const first = FIGURE_SCENES[0];
---

<figure class="figure-card" data-figure>
  <svg
    data-figure-svg
    viewBox="0 0 240 200"
    width="100%"
    role="img"
    aria-label={`简笔画：${first.label}`}
  >
    <path
      class="scene-ground"
      d={GROUND_PATH}
      fill="none"
      stroke-width="1.4"
      stroke-linecap="round"
    />
    <g
      class="scene-paths"
      data-figure-paths
      fill="none"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      {first.paths.map((d, i) => (
        <path
          d={d}
          pathLength="1"
          style={`stroke-dasharray: 1; stroke-dashoffset: 0; transition: stroke-dashoffset 0.5s ease ${i * 0.05}s;`}
        />
      ))}
    </g>
  </svg>
  <figcaption data-figure-caption>{first.line}</figcaption>
  <div class="figure-controls" role="group" aria-label="切换场景">
    {FIGURE_SCENES.map((scene, i) => (
      <button
        type="button"
        class="figure-btn"
        data-scene={scene.id}
        aria-pressed={i === 0 ? 'true' : 'false'}
      >
        {scene.label}
      </button>
    ))}
  </div>
</figure>

<script>
  import { initFigure } from './controller';

  const root = document.querySelector('[data-figure]');
  if (root instanceof HTMLElement) initFigure(root);
</script>
