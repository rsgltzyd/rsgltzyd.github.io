---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const postPath = (id: string) => `/posts/${id.replace(/\.md$/, '')}/`;

const formatDate = (date: Date) => new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(date);
---

<BlogLayout title="Fieldnotes — Writing & observations" description="Notes on making things, the web, and everything in between.">
  <section class="intro" aria-labelledby="intro-title">
    <div class="intro-copy">
      <p class="eyebrow"><span class="status-dot"></span> An ongoing collection</p>
      <h1 id="intro-title">Curiosity,<br />put into <em>words.</em></h1>
      <p class="intro-description">Notes on making things, the web, and everything in between. A little space to notice, learn, and share.</p>
    </div>
    <div class="intro-art" aria-hidden="true">
      <img src="https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=1000&q=85" alt="" />
      <span class="art-label">somewhere, lately</span>
      <span class="art-index">01 / ∞</span>
    </div>
  </section>

  <section class="writing-section" aria-labelledby="writing-title">
    <div class="section-heading">
      <h2 id="writing-title">Recent writing <span>({posts.length.toString().padStart(2, '0')})</span></h2>
      <span class="section-note">Thoughts in progress, shared.</span>
    </div>
    <div class="post-list">
      {posts.map((post, index) => (
        <article class="post-row" style={`--row-index: ${index}`}>
          <a class="post-image" href={postPath(post.id)} tabindex="-1" aria-hidden="true">
            <img src={post.data.cover} alt="" loading={index > 1 ? 'lazy' : 'eager'} />
          </a>
          <div class="post-copy">
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              <span class="meta-divider"></span>
              <span>{post.data.tags[0] ?? 'Journal'}</span>
            </div>
            <h3><a href={postPath(post.id)}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
          </div>
          <a class="post-arrow" href={postPath(post.id)} aria-label={`Read ${post.data.title}`}>
            <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>
  </section>
</BlogLayout>