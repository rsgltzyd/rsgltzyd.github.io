---
import BlogLayout from '../layouts/BlogLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import '../styles/home.css';
---

<BlogLayout title="雨霖铃" description="做有趣的东西。游戏可以开始。" lang="zh-CN">
  <div class="view-panel view-pane" data-view-panel="home">
    <Hero />
  </div>

  <!-- 关于独立同页视图 -->
  <div class="view-panel view-pane about-page" data-view-panel="about" hidden>
    <div class="view-top-nav">
      <a href="/#home" class="back-home-link">← 回首页</a>
    </div>
    <About />
  </div>

  <script>
    type MagazineView = 'home' | 'about';

    let viewsBound = false;

    function resolveView(): MagazineView {
      return window.location.hash.toLowerCase() === '#about' ? 'about' : 'home';
    }

    function livePanels() {
      return document.querySelectorAll<HTMLElement>('[data-view-panel]');
    }

    function switchView(view: MagazineView, shouldScroll = false) {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches === true;
      livePanels().forEach((panel) => {
        const isMatch = panel.getAttribute('data-view-panel') === view;
        const wasHidden = panel.hidden;
        panel.hidden = !isMatch;
        if (isMatch && wasHidden && !reduced) {
          panel.classList.remove('view-pane');
          void panel.offsetWidth;
          panel.classList.add('view-pane');
        }
      });

      document.querySelectorAll<HTMLAnchorElement>('[data-nav-view]').forEach((link) => {
        const targetView = link.getAttribute('data-nav-view');
        const isActive = view === 'about' && targetView === 'about';
        link.classList.toggle('active', isActive);
        if (isActive) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });

      if (shouldScroll) window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function isModifiedClick(event: MouseEvent) {
      return event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey;
    }

    function onHashChange() {
      if (window.location.hash.toLowerCase() === '#game') {
        window.location.replace('/games');
        return;
      }
      if (livePanels().length === 0) return;
      switchView(resolveView(), true);
    }

    function onClick(event: MouseEvent) {
      const target = event.target as HTMLElement | null;
      const link = target?.closest<HTMLAnchorElement>('a[data-nav-view], a[href^="/#"], a[href^="#"]');
      if (!link || (link.target && link.target !== '_self') || isModifiedClick(event)) return;
      if (livePanels().length === 0) return;

      const href = link.getAttribute('href') || '';
      const isHome = href === '/' || href === '/#home' || href === '#home';
      const isAbout = href === '/#about' || href === '#about';
      const isLegacyGame = href === '/#game' || href === '#game';
      if (isLegacyGame) {
        event.preventDefault();
        window.location.assign('/games');
        return;
      }
      if (href === '/games' || href === '/games/') return;
      if (isHome) {
        event.preventDefault();
        if (window.location.hash) history.pushState(null, '', window.location.pathname);
        switchView('home', true);
        return;
      }
      if (isAbout) {
        event.preventDefault();
        window.location.hash = 'about';
        switchView('about', true);
      }
    }

    function setupViews() {
      if (window.location.hash.toLowerCase() === '#game') {
        window.location.replace('/games');
        return;
      }
      if (livePanels().length === 0) return;
      switchView(resolveView(), false);
    }

    if (!viewsBound) {
      viewsBound = true;
      window.addEventListener('hashchange', onHashChange);
      document.addEventListener('click', onClick, true);
      document.addEventListener('astro:page-load', setupViews);
      document.addEventListener('astro:after-swap', setupViews);
    }

    setupViews();
  </script>
</BlogLayout>

<style>
  .view-panel {
    width: 100%;
  }

  .view-panel[hidden] {
    display: none !important;
  }

  .view-top-nav {
    padding: 0;
    margin: 0;
  }
</style>
