---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import Hero from '../components/Hero.astro';
import ArticleList from '../components/articles/ArticleList.astro';
import About from '../components/About.astro';
import GameDeck from '../components/games/GameDeck.astro';
import '../styles/home.css';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const articles = await Promise.all(
  posts.map(async (post) => {
    const { Content } = await render(post);
    return {
      id: post.id,
      href: `/posts/${post.id.replace(/\.md$/, '')}/`,
      title: post.data.title,
      description: post.data.description,
      pubDate: post.data.pubDate,
      tags: post.data.tags,
      Content,
    };
  }),
);
---

<BlogLayout title="雨霖铃" description="做有趣的东西。文章可以读，游戏可以开始。" lang="zh-CN">
  <!-- 首页主视图：只留人物 (Hero) + 精选文章 (ArticleList) -->
  <div class="view-panel view-pane" data-view-panel="home">
    <Hero />
    <div class="home-block">
      <ArticleList isFeatured={true} />
    </div>
  </div>

  <!-- 游戏独立同页视图 -->
  <div class="view-panel view-pane games-page" data-view-panel="game" hidden>
    <div class="view-top-nav">
      <a href="/#home" class="back-home-link">← 回首页</a>
    </div>
    <GameDeck />
  </div>

  <!-- 关于独立同页视图 -->
  <div class="view-panel view-pane about-page" data-view-panel="about" hidden>
    <div class="view-top-nav">
      <a href="/#home" class="back-home-link">← 回首页</a>
    </div>
    <About />
  </div>

  <!-- 文章独立同页视图：切过来不换 document.head -->
  <div class="view-panel view-pane articles-page" data-view-panel="articles" hidden>
    <div class="view-top-nav">
      <a href="/#home" class="back-home-link">← 回首页</a>
    </div>
    <ArticleList isFeatured={false} />
  </div>

  <script>
    type MagazineView = 'home' | 'game' | 'about' | 'articles';

    let viewsBound = false;

    function setupViews() {
      const panels = document.querySelectorAll<HTMLElement>('[data-view-panel]');
      if (panels.length === 0) return;

      const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-view]');

      function resolveView(): MagazineView {
        const hash = window.location.hash.toLowerCase();
        if (hash === '#game') return 'game';
        if (hash === '#about') return 'about';
        if (hash === '#articles' || hash === '#posts') return 'articles';
        return 'home';
      }

      function switchView(view: MagazineView, shouldScroll = false) {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches === true;
        panels.forEach((panel) => {
          const isMatch = panel.getAttribute('data-view-panel') === view;
          panel.hidden = !isMatch;
          if (isMatch && !reduced) {
            panel.classList.remove('view-pane');
            void panel.offsetWidth;
            panel.classList.add('view-pane');
          }
        });

        navLinks.forEach((link) => {
          const targetView = link.getAttribute('data-nav-view');
          const isActive =
            (view === 'game' && targetView === 'game') ||
            (view === 'about' && targetView === 'about') ||
            (view === 'articles' && targetView === 'posts');
          link.classList.toggle('active', isActive);
          if (targetView === 'posts') {
            if (isActive) link.setAttribute('aria-current', 'page');
            else link.removeAttribute('aria-current');
          }
        });

        if (shouldScroll) {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        if (view === 'game') {
          window.dispatchEvent(new Event('resize'));
        }
      }

      function isModifiedClick(event: MouseEvent) {
        return event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey;
      }

      function hrefOf(link: HTMLAnchorElement) {
        return link.getAttribute('href') || '';
      }

      function isHomeHref(href: string) {
        return href === '/' || href === '/#home' || href === '#home';
      }

      function isGameHref(href: string) {
        return href === '/#game' || href === '#game';
      }

      function isAboutHref(href: string) {
        return href === '/#about' || href === '#about';
      }

      function isArticlesHref(href: string, link: HTMLAnchorElement) {
        return (
          href === '/posts/' ||
          href === '/posts' ||
          href === '/#articles' ||
          href === '#articles' ||
          href === '/#posts' ||
          href === '#posts' ||
          link.getAttribute('data-nav-view') === 'posts'
        );
      }

      function onHashChange() {
        switchView(resolveView(), true);
      }

      function onClick(e: MouseEvent) {
        const target = e.target as HTMLElement | null;
        if (!target) return;
        const link = target.closest<HTMLAnchorElement>(
          'a[data-nav-view], a[href^="/#"], a[href^="#"], a[href="/posts/"], a[href="/posts"]',
        );
        if (!link) return;
        if (link.target && link.target !== '_self') return;
        if (isModifiedClick(e)) return;

        const href = hrefOf(link);
        if (isHomeHref(href)) {
          e.preventDefault();
          if (window.location.hash) {
            history.pushState(null, '', window.location.pathname);
          }
          switchView('home', true);
          return;
        }
        if (isGameHref(href)) {
          e.preventDefault();
          window.location.hash = 'game';
          switchView('game', true);
          return;
        }
        if (isAboutHref(href)) {
          e.preventDefault();
          window.location.hash = 'about';
          switchView('about', true);
          return;
        }
        if (isArticlesHref(href, link)) {
          e.preventDefault();
          window.location.hash = 'articles';
          switchView('articles', true);
        }
      }

      if (!viewsBound) {
        viewsBound = true;
        window.addEventListener('hashchange', onHashChange);
        document.addEventListener('click', onClick);
      }

      switchView(resolveView(), false);
    }

    setupViews();
    document.addEventListener('astro:page-load', setupViews);
  </script>
</BlogLayout>

<style>
  .view-panel {
    width: 100%;
  }

  .home-block {
    margin-bottom: 24px;
  }

  .view-panel[hidden] {
    display: none !important;
  }

  .view-top-nav {
    padding: 0;
    margin: 0;
  }

  @media (max-width: 640px) {
    .home-block {
      margin-bottom: 28px;
    }
  }
</style>
