---
import BlogLayout from '../layouts/BlogLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import '../styles/home.css';
---

<BlogLayout title="雨霖铃" description="做有趣的东西。" lang="zh-CN">
  <div class="view-panel view-pane" data-view-panel="home">
    <Hero />
  </div>

  <div
    class="about-sheet-overlay"
    data-view-panel="about"
    role="dialog"
    aria-modal="true"
    aria-labelledby="about-heading"
    hidden
  >
    <div class="about-sheet-backdrop" data-about-close aria-hidden="true"></div>
    <article class="about-sheet" data-about-sheet>
      <header class="about-sheet-head">
        <span class="about-sheet-tag">关于小站 · 完整手记</span>
        <button
          type="button"
          class="about-sheet-close"
          data-about-close
          aria-label="收起关于纸片"
          title="收起纸片 (Esc)"
        >
          <svg aria-hidden="true" viewBox="0 0 20 20" width="15" height="15" fill="none">
            <path
              d="M5 5L15 15M15 5L5 15"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </header>
      <div class="about-sheet-body">
        <About />
      </div>
      <footer class="about-sheet-foot">
        <span class="about-sheet-hint">按 Esc 或点击空白处收起</span>
        <button type="button" class="about-sheet-fold-btn" data-about-close>
          <span>合上纸片</span>
          <svg aria-hidden="true" viewBox="0 0 16 16" width="13" height="13" fill="none">
            <path
              d="M4 10L8 6L12 10"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </footer>
    </article>
  </div>

  <script>
    function clamp(value: number, min: number, max: number): number {
      return Math.max(min, Math.min(max, value));
    }

    function prefersReducedMotion(): boolean {
      return window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches === true;
    }

    function isModifiedClick(event: MouseEvent): boolean {
      return event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey;
    }

    function getSourceCardRect(): DOMRect | null {
      const card = document.querySelector<HTMLElement>('.cd-card[data-kind="about"]');
      if (!card) return null;
      const rect = card.getBoundingClientRect();
      return rect.width > 0 && rect.height > 0 ? rect : null;
    }

    interface OpenOptions {
      animate?: boolean;
      triggerEl?: HTMLElement | null;
    }

    interface CloseOptions {
      animate?: boolean;
      updateUrl?: boolean;
    }

    let activePanel: HTMLElement | null = null;
    let activeCleanup: (() => void) | null = null;

    function initAboutSheet(): void {
      const homeEl = document.querySelector<HTMLElement>('[data-view-panel="home"]');
      const aboutEl = document.querySelector<HTMLElement>('[data-view-panel="about"]');
      if (!homeEl || !aboutEl) {
        if (activeCleanup) {
          activeCleanup();
          activeCleanup = null;
          activePanel = null;
        }
        return;
      }
      if (activePanel === aboutEl) return;
      if (activeCleanup) {
        activeCleanup();
        activeCleanup = null;
        activePanel = null;
      }

      const homePanel = homeEl;
      const aboutPanel = aboutEl;
      const sheetEl = aboutPanel.querySelector<HTMLElement>('[data-about-sheet]');
      const backdropEl = aboutPanel.querySelector<HTMLElement>('.about-sheet-backdrop');
      const closeBtn = aboutPanel.querySelector<HTMLButtonElement>('.about-sheet-close');
      if (!sheetEl || !backdropEl) return;
      const sheet = sheetEl;
      const backdrop = backdropEl;

      let isOpen = false;
      let isAnimating = false;
      let activeAnimation: Animation[] = [];
      let pinchDelta = 0;
      let pinchResetTimer: number | null = null;
      let lastTriggerEl: HTMLElement | null = null;

      function clearPinchState(): void {
        if (pinchResetTimer !== null) {
          window.clearTimeout(pinchResetTimer);
          pinchResetTimer = null;
        }
        pinchDelta = 0;
      }

      function cancelActiveAnimations(): void {
        activeAnimation.forEach((anim) => {
          try {
            anim.cancel();
          } catch {
            /* ignore */
          }
        });
        activeAnimation = [];
        isAnimating = false;
      }

      function openAboutSheet({ animate = true, triggerEl = null }: OpenOptions = {}): void {
        if (
          (isOpen && !isAnimating) ||
          aboutPanel.dataset.state === 'open' ||
          aboutPanel.dataset.state === 'opening'
        ) {
          return;
        }
        cancelActiveAnimations();
        clearPinchState();

        lastTriggerEl = triggerEl;
        isOpen = true;
        aboutPanel.hidden = false;
        aboutPanel.dataset.state = 'opening';
        document.documentElement.classList.add('has-about-sheet');
        homePanel.classList.add('is-sheet-open');
        homePanel.setAttribute('inert', '');

        if (animate && !prefersReducedMotion() && typeof sheet.animate === 'function') {
          const targetRect = sheet.getBoundingClientRect();
          const sourceRect = getSourceCardRect();
          let fromTransform =
            'translate3d(0, 26px, 0) scale(0.92) perspective(1100px) rotateX(-6deg)';
          if (sourceRect && targetRect.width > 0 && targetRect.height > 0) {
            const dx =
              sourceRect.left + sourceRect.width / 2 - (targetRect.left + targetRect.width / 2);
            const dy =
              sourceRect.top + sourceRect.height / 2 - (targetRect.top + targetRect.height / 2);
            const sx = clamp(sourceRect.width / targetRect.width, 0.5, 1.1);
            const sy = clamp(sourceRect.height / targetRect.height, 0.45, 1.1);
            fromTransform = `translate3d(${dx.toFixed(2)}px, ${dy.toFixed(2)}px, 0) scale(${sx.toFixed(4)}, ${sy.toFixed(4)}) perspective(1100px) rotateX(-7deg)`;
          }

          isAnimating = true;
          const sheetAnim = sheet.animate(
            [
              { transform: fromTransform, opacity: 0.72 },
              {
                transform: 'translate3d(0, 0, 0) scale(1, 1) perspective(1100px) rotateX(0deg)',
                opacity: 1,
              },
            ],
            { duration: 360, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'both' },
          );
          const backdropAnim = backdrop.animate([{ opacity: 0 }, { opacity: 1 }], {
            duration: 260,
            easing: 'ease-out',
            fill: 'both',
          });
          activeAnimation = [sheetAnim, backdropAnim];

          sheetAnim.onfinish = () => {
            if (!isOpen || aboutPanel.dataset.state !== 'opening') return;
            sheetAnim.cancel();
            backdropAnim.cancel();
            activeAnimation = [];
            isAnimating = false;
            aboutPanel.dataset.state = 'open';
            closeBtn?.focus({ preventScroll: true });
          };
          return;
        }

        aboutPanel.dataset.state = 'open';
        closeBtn?.focus({ preventScroll: true });
      }

      function closeAboutSheet({ animate = true, updateUrl = true }: CloseOptions = {}): void {
        if ((!isOpen && aboutPanel.hidden) || aboutPanel.dataset.state === 'closing') {
          return;
        }
        cancelActiveAnimations();
        clearPinchState();

        isOpen = false;
        aboutPanel.dataset.state = 'closing';
        homePanel.classList.remove('is-sheet-open');
        homePanel.removeAttribute('inert');

        if (updateUrl && window.location.hash.toLowerCase() === '#about') {
          history.pushState(null, '', window.location.pathname);
        }

        const finishClose = () => {
          activeAnimation = [];
          isAnimating = false;
          aboutPanel.hidden = true;
          delete aboutPanel.dataset.state;
          document.documentElement.classList.remove('has-about-sheet');
          if (lastTriggerEl && lastTriggerEl.isConnected && !lastTriggerEl.closest('[inert]')) {
            lastTriggerEl.focus({ preventScroll: true });
          }
          lastTriggerEl = null;
        };

        if (animate && !prefersReducedMotion() && typeof sheet.animate === 'function') {
          const currentRect = sheet.getBoundingClientRect();
          const sourceRect = getSourceCardRect();
          let toTransform =
            'translate3d(0, 22px, 0) scale(0.92) perspective(1100px) rotateX(5deg)';
          if (sourceRect && currentRect.width > 0 && currentRect.height > 0) {
            const dx =
              sourceRect.left + sourceRect.width / 2 - (currentRect.left + currentRect.width / 2);
            const dy =
              sourceRect.top + sourceRect.height / 2 - (currentRect.top + currentRect.height / 2);
            const sx = clamp(sourceRect.width / currentRect.width, 0.5, 1.1);
            const sy = clamp(sourceRect.height / currentRect.height, 0.45, 1.1);
            toTransform = `translate3d(${dx.toFixed(2)}px, ${dy.toFixed(2)}px, 0) scale(${sx.toFixed(4)}, ${sy.toFixed(4)}) perspective(1100px) rotateX(6deg)`;
          }

          isAnimating = true;
          const sheetAnim = sheet.animate(
            [
              {
                transform: 'translate3d(0, 0, 0) scale(1, 1) perspective(1100px) rotateX(0deg)',
                opacity: 1,
              },
              { transform: toTransform, opacity: 0 },
            ],
            { duration: 280, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'both' },
          );
          const backdropAnim = backdrop.animate([{ opacity: 1 }, { opacity: 0 }], {
            duration: 240,
            easing: 'ease-in',
            fill: 'both',
          });
          activeAnimation = [sheetAnim, backdropAnim];

          sheetAnim.onfinish = () => {
            if (isOpen || aboutPanel.dataset.state !== 'closing') return;
            sheetAnim.cancel();
            backdropAnim.cancel();
            finishClose();
          };
          return;
        }

        finishClose();
      }

      function onDocumentClick(event: MouseEvent): void {
        const target = event.target as HTMLElement | null;
        if (!target) return;

        const closeTrigger = target.closest<HTMLElement>('[data-about-close]');
        if (closeTrigger && aboutPanel.contains(closeTrigger)) {
          event.preventDefault();
          closeAboutSheet({ animate: true, updateUrl: true });
          return;
        }

        const link = target.closest<HTMLAnchorElement>(
          'a[href="/#about"], a[href="#about"], a[data-nav-view="home"], a[href="/#home"], a[href="#home"]',
        );
        if (!link || (link.target && link.target !== '_self') || isModifiedClick(event)) return;

        const href = link.getAttribute('href') || '';
        if (href === '/#about' || href === '#about') {
          event.preventDefault();
          if (window.location.hash.toLowerCase() !== '#about') {
            history.pushState(null, '', '#about');
          }
          openAboutSheet({ animate: true, triggerEl: link });
          return;
        }

        if (isOpen || !aboutPanel.hidden) {
          event.preventDefault();
          closeAboutSheet({ animate: true, updateUrl: true });
        } else if (window.location.hash) {
          event.preventDefault();
          history.pushState(null, '', window.location.pathname);
        }
      }

      function onKeyDown(event: KeyboardEvent): void {
        if (event.key === 'Escape' && (isOpen || !aboutPanel.hidden)) {
          event.preventDefault();
          closeAboutSheet({ animate: true, updateUrl: true });
        }
      }

      function onAboutWheel(event: WheelEvent): void {
        if (!isOpen && aboutPanel.hidden) return;
        if (!event.ctrlKey) return;
        event.preventDefault();
        if (event.deltaY <= 0) return;

        pinchDelta += event.deltaY;
        if (pinchResetTimer !== null) {
          window.clearTimeout(pinchResetTimer);
        }
        pinchResetTimer = window.setTimeout(() => {
          pinchResetTimer = null;
          pinchDelta = 0;
        }, 220);

        if (pinchDelta >= 18) {
          clearPinchState();
          closeAboutSheet({ animate: true, updateUrl: true });
        }
      }

      function onRouteSync(): void {
        const wantsAbout = window.location.hash.toLowerCase() === '#about';
        if (wantsAbout) {
          if (!isOpen && aboutPanel.dataset.state !== 'opening') {
            openAboutSheet({ animate: true, triggerEl: null });
          }
        } else if (isOpen || !aboutPanel.hidden) {
          closeAboutSheet({ animate: true, updateUrl: false });
        }
      }

      document.addEventListener('click', onDocumentClick, true);
      document.addEventListener('keydown', onKeyDown);
      aboutPanel.addEventListener('wheel', onAboutWheel, { passive: false });
      window.addEventListener('popstate', onRouteSync);
      window.addEventListener('hashchange', onRouteSync);

      if (window.location.hash.toLowerCase() === '#about') {
        openAboutSheet({ animate: false, triggerEl: null });
      }

      activePanel = aboutPanel;
      activeCleanup = () => {
        cancelActiveAnimations();
        clearPinchState();
        document.documentElement.classList.remove('has-about-sheet');
        homePanel.classList.remove('is-sheet-open');
        homePanel.removeAttribute('inert');
        document.removeEventListener('click', onDocumentClick, true);
        document.removeEventListener('keydown', onKeyDown);
        aboutPanel.removeEventListener('wheel', onAboutWheel);
        window.removeEventListener('popstate', onRouteSync);
        window.removeEventListener('hashchange', onRouteSync);
      };
    }

    function teardownAboutSheet(): void {
      if (activeCleanup) {
        activeCleanup();
        activeCleanup = null;
      }
      activePanel = null;
    }

    initAboutSheet();
    document.addEventListener('astro:page-load', initAboutSheet);
    document.addEventListener('astro:after-swap', initAboutSheet);
    document.addEventListener('astro:before-swap', teardownAboutSheet);
  </script>
</BlogLayout>

<style>
  .view-panel {
    width: 100%;
  }

  [data-view-panel="home"] {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>
