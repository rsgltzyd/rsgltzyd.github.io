---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import Hero from '../components/Hero.astro';
import ArticleList from '../components/articles/ArticleList.astro';
import About from '../components/About.astro';
import GameDeck from '../components/games/GameDeck.astro';
import '../styles/home.css';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const articles = await Promise.all(
  posts.map(async (post) => {
    const { Content } = await render(post);
    return {
      id: post.id,
      href: `/posts/${post.id.replace(/\.md$/, '')}/`,
      title: post.data.title,
      description: post.data.description,
      pubDate: post.data.pubDate,
      tags: post.data.tags,
      Content,
    };
  }),
);
---

<BlogLayout title="雨霖铃" description="做有趣的东西。文章现在可以读，游戏还在准备。" lang="zh-CN">
  <Hero />
  <GameDeck />
  <ArticleList articles={articles} />
  <About />
</BlogLayout>
