---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { formatUtcDateOnly, isSamplePost, utcDateOnlyAttribute } from '../../components/articles/samplePosts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id.replace(/\.md$/, '') }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formattedDate = formatUtcDateOnly(post.data.pubDate);
const dateTime = utcDateOnlyAttribute(post.data.pubDate);
const sample = isSamplePost(post.id);
---

<BlogLayout title={`${post.data.title} — 雨霖铃`} description={post.data.description} lang="zh-CN">
  <article class="article-page">
    <p class="article-toolbar">
      <a class="back-link" href="/#articles">返回文章</a>
    </p>
    {sample ? <p class="sample-line"><span class="sample-badge">示例文章</span></p> : null}
    <header class="article-header" lang="en">
      <div class="article-meta">
        <time datetime={dateTime}>{formattedDate}</time>
        {post.data.tags.length > 0 && (
          <ul class="tag-list">
            {post.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )}
      </div>
      <h1>{post.data.title}</h1>
      <p class="article-deck">{post.data.description}</p>
    </header>
    <img class="article-cover" src={post.data.cover} alt="" width="1200" height="675" />
    <div class="prose" lang="en">
      <Content />
    </div>
    <p class="article-toolbar article-toolbar-end">
      <a class="back-link" href="/#articles">返回文章</a>
    </p>
  </article>
</BlogLayout>
