---
import BlogLayout from '../layouts/BlogLayout.astro';
import SnowGlobe from '../components/globe/SnowGlobe.astro';
---

<BlogLayout
  title="四季玻璃球 · 雨霖铃"
  description="春夏秋冬四季 Three.js 雪花玻璃球，支持旋转缩放、昼夜天象与天气切换。"
>
  <div class="globe-page">
    <div class="view-top-nav">
      <a href="/" class="back-home-link">← 回首页</a>
    </div>

    <div class="chapter-head">
      <div class="chapter-head-row">
        <span class="chapter-head-no">№ 01</span>
        <h1 class="chapter-head-title">四季玻璃球</h1>
        <span class="chapter-head-note">拖拽旋转 · 滚轮缩放 · 摇一摇</span>
      </div>
    </div>

    <SnowGlobe />
  </div>
</BlogLayout>
