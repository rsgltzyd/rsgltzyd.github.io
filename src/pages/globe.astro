---
import BlogLayout from '../layouts/BlogLayout.astro';
import SnowGlobe from '../components/globe/SnowGlobe.astro';
---

<BlogLayout
  title="四季玻璃球 · 雨霖铃"
  description="春夏秋冬四季 Three.js 雪花玻璃球，支持旋转缩放、昼夜天象与天气切换。"
>
  <div class="globe-page">
    <div class="chapter-head globe-chapter-head">
      <div class="chapter-head-row globe-head-row">
        <div class="globe-head-title-group">
          <span class="chapter-head-no">№ 01</span>
          <h1 class="chapter-head-title">四季玻璃球</h1>
          <span class="globe-head-hint">拖拽旋转 · 滚轮缩放 · 摇一摇</span>
        </div>
        <a
          href="/"
          class="globe-return-btn"
          aria-label="放回书桌，返回首页"
        >
          <svg aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none">
            <rect x="3" y="6" width="10" height="11" rx="1.2" stroke="currentColor" stroke-width="1.35" />
            <path
              d="M6.5 6V4.2c0-.66.54-1.2 1.2-1.2H15.8c.66 0 1.2.54 1.2 1.2V13.8c0 .66-.54 1.2-1.2 1.2H13"
              stroke="currentColor"
              stroke-width="1.35"
              stroke-linecap="round"
            />
          </svg>
          <span>放回书桌</span>
        </a>
      </div>
    </div>

    <SnowGlobe />
  </div>
</BlogLayout>
