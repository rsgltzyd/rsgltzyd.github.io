---
import BlogLayout from '../../layouts/BlogLayout.astro';
import GameDeck from '../../components/games/GameDeck.astro';
import { GAME_LIST } from '../../components/games/controller';

export function getStaticPaths() {
  return GAME_LIST.map((game) => ({
    params: { id: game.id },
    props: { game },
  }));
}

interface Props {
  game: (typeof GAME_LIST)[number];
}

const { game } = Astro.props;
---

<BlogLayout title={`${game.label} · 小游戏`} description={game.blurb} bare>
  <div class="game-stage-page">
    <a class="game-exit" href="/games" aria-label="回到游戏入口">退出</a>
    <GameDeck id={game.id} />
  </div>
</BlogLayout>
