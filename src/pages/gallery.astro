---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import GalleryFeed from '../components/gallery/GalleryFeed.astro';

const entries = await getCollection('gallery', ({ data }) => !data.draft);
entries.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const renderedPosts = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      id: entry.id,
      title: entry.data.title,
      pubDate: entry.data.pubDate,
      location: entry.data.location,
      tags: entry.data.tags,
      images: entry.data.images,
      Content,
    };
  }),
);
---

<BlogLayout
  title="影像手记 · 雨霖铃"
  description="用 Markdown 与相纸记下的日常光影、街拍与案头小物。"
>
  <div class="gallery-page">
    <div class="chapter-head gallery-chapter-head">
      <div class="chapter-head-row gallery-head-row">
        <div class="gallery-head-title-group">
          <span class="chapter-head-no">№ 02</span>
          <h1 class="chapter-head-title">影像手记</h1>
          <span class="gallery-head-hint">点击放大 · 双指横滑或自动播放</span>
        </div>
        <a
          href="/"
          class="gallery-return-btn"
          aria-label="放回书桌，返回首页"
        >
          <svg aria-hidden="true" viewBox="0 0 20 20" width="14" height="14" fill="none">
            <rect x="3" y="6" width="10" height="11" rx="1.2" stroke="currentColor" stroke-width="1.35" />
            <path
              d="M6.5 6V4.2c0-.66.54-1.2 1.2-1.2H15.8c.66 0 1.2.54 1.2 1.2V13.8c0 .66-.54 1.2-1.2 1.2H13"
              stroke="currentColor"
              stroke-width="1.35"
              stroke-linecap="round"
            />
          </svg>
          <span>放回书桌</span>
        </a>
      </div>
    </div>

    <GalleryFeed posts={renderedPosts} />
  </div>
</BlogLayout>
